                    p.f.Position = UDim2.fromOffset(W2 / 2 + cos(p.a) * p.r, H2 / 2 + sin(p.a) * p.r)
                    p.f.BackgroundTransparency = math.clamp(p.r / (W2 * 0.6), 0.1, 0.9)
                end
            end)
        end

        MYFX.emberRise = function(tok, W2, H2, th)
            emit(tok, function() return 0.12 + rand() * 0.15 end, function()
                local e = circ(fr({ AnchorPoint = C, Position = UDim2.fromScale(rand(), 1.05), Size = UDim2.fromOffset(rand(3, 6), rand(3, 6)),
                    BackgroundColor3 = rand() < 0.5 and th.Accent or th.Accent2 }))
                local dur, ph, sx, t0 = 2.5 + rand() * 2, rand() * 6.28, e.Position.X.Scale, os.clock()
                task.spawn(function()
                    while os.clock() - t0 < dur and e.Parent and fxTok == tok do
                        local pr = (os.clock() - t0) / dur
                        e.Position = UDim2.fromScale(sx + sin(pr * 6 + ph) * 0.05, 1.05 - pr * 1.1)
                        e.BackgroundTransparency = pr * 0.8
                        task.wait(0.03)
                    end
                    e:Destroy()
                end)
            end)
        end

        MYFX.dataLanes = function(tok, W2, H2, th)
            local lanes = 8
            for i = 1, lanes do
                fr({ Position = UDim2.new(0, 0, (i - 0.5) / lanes, 0), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = th.Accent, BackgroundTransparency = 0.88 })
            end
            emit(tok, 0.18, function()
                local lane = rand(1, lanes)
                local len, dur, dir = rand(14, 50), 1 + rand() * 1.5, rand() < 0.5 and 1 or -1
                local p = fr({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(dir == 1 and -0.1 or 1.1, 0, (lane - 0.5) / lanes, 0),
                    Size = UDim2.fromOffset(len, 4), BackgroundColor3 = rand() < 0.3 and th.Accent2 or th.Accent })
                new("UIGradient", { Transparency = NumberSequence.new(dir == 1 and { NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }
                    or { NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, p)
                tween(p, { Position = UDim2.new(dir == 1 and 1.1 or -0.1, 0, (lane - 0.5) / lanes, 0) }, dur, LIN)
                Debris:AddItem(p, dur + 0.1)
            end)
        end

        MYFX.phoenixFlames = function(tok, W2, H2, th)
            local fl = {}
            for i = 1, 6 do
                local f = fr({ AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(40, 100), BackgroundColor3 = th.Accent })
                new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
                new("UIGradient", { Rotation = 90, Color = ColorSequence.new(th.Accent2, th.Accent),
                    Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0.9) }) }, f)
                fl[i] = { f = f, bx = (i - 0.5) / 6 * W2 }
            end
            loop(tok, function(t)
                for i, o in ipairs(fl) do
                    o.f.Position = UDim2.fromOffset(o.bx + sin(t * 2 + i) * 15, H2 + 10)
                    o.f.Size = UDim2.fromOffset(34 + sin(t * 2.5 + i) * 6, 110 + sin(t * 3 + i) * 25 + rand() * 20)
                    o.f.Rotation = sin(t * 1.5 + i) * 6
                end
            end, 0.05)
        end

        MYFX.silkRipples = function(tok, W2, H2, th)
            emit(tok, 0.8, function()
                local d = circ(fr({ AnchorPoint = C, Position = UDim2.fromScale(rand(), rand()), Size = UDim2.fromOffset(60, 60), BackgroundTransparency = 1 }))
                local st = new("UIStroke", { Color = rand() < 0.5 and th.Accent or th.Accent2, Thickness = 1.5, Transparency = 0.8 }, d)
                tween(d, { Size = UDim2.fromOffset(220, 220) }, 3, SINE); tween(st, { Transparency = 1 }, 3, SINE)
                Debris:AddItem(d, 3.1)
            end)
        end

        MYFX.moonBeams = function(tok, W2, H2, th)
            glow({ Position = UDim2.fromScale(0.82, 0.16), Size = UDim2.fromOffset(120, 120), ImageColor3 = th.Accent2, ImageTransparency = 0.5 })
            circ(fr({ AnchorPoint = C, Position = UDim2.fromScale(0.82, 0.16), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = th.Accent, BackgroundTransparency = 0.1 }))
            local bm = {}
            for i = 1, 4 do
                local b = fr({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new((i - 0.5) / 4, 0, -0.1, 0), Size = UDim2.new(0.08, 0, 1.3, 0),
                    BackgroundColor3 = th.Accent, BackgroundTransparency = 0.88 })
                new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.3, 0.3), NumberSequenceKeypoint.new(1, 0.9) }) }, b)
                bm[i] = b
            end
            stars(tok, th, 16)
            loop(tok, function(t) for i, b in ipairs(bm) do
                b.Rotation = sin(t * 0.3 + i) * 6; b.BackgroundTransparency = 0.85 + sin(t * 0.7 + i) * 0.05 end end, 0.05)
        end

        MYFX.ashDrift = function(tok, W2, H2, th)
            emit(tok, function() return 0.25 + rand() * 0.3 end, function()
                local f = fr({ AnchorPoint = C, Position = UDim2.fromScale(rand(), -0.05), Size = UDim2.fromOffset(rand(3, 6), rand(3, 6)),
                    BackgroundColor3 = th.Text:Lerp(th.Background, 0.5), Rotation = rand(0, 360) })
                local dur = 5 + rand() * 3
                tween(f, { Position = UDim2.fromScale(f.Position.X.Scale + (rand() - 0.5) * 0.15, 1.05), Rotation = f.Rotation + rand(-90, 90) }, dur, LIN)
                Debris:AddItem(f, dur + 0.1)
            end)
        end

        MYFX.iceCracks = function(tok, W2, H2, th)
            local cx, cy = W2 / 2, H2 / 2
            local function crack(x, y, ang, len, depth)
                local nx, ny = x + cos(ang) * len, y + sin(ang) * len
                local l = line(myLayer, x, y, nx, ny, 1.5, th.Accent, 1)
                tween(l, { BackgroundTransparency = 1 }, 2.2); Debris:AddItem(l, 2.3)
                if depth > 0 then
                    crack(nx, ny, ang + (rand() - 0.5) * 0.6, len * 0.8, depth - 1)
                    if rand() < 0.6 then crack(nx, ny, ang + (rand() < 0.5 and 1 or -1) * (0.6 + rand() * 0.5), len * 0.6, depth - 1) end
                end
            end
            emit(tok, 0.5, function() crack(cx, cy, rand() * 6.28, 30 + rand() * 20, 3) end)
        end

        MYFX.primordialVoid = function(tok, W2, H2, th)
            local core = glow({ Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(120, 120), ImageColor3 = th.Accent, ImageTransparency = 0.6 })
            local inner = glow({ Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(60, 60), ImageColor3 = th.Accent2, ImageTransparency = 0.5, ZIndex = 2 })
            local sp = {}
            for i = 1, 14 do sp[i] = { f = circ(fr({ AnchorPoint = C, Size = UDim2.fromOffset(3, 3), BackgroundColor3 = th.Accent2 })), a = rand() * 6.28, r = 70 + rand() * 90, s = 0.3 + rand() * 0.6 } end
            loop(tok, function(t)
                local s = 120 + sin(t * 1.5) * 20
                core.Size = UDim2.fromOffset(s, s); core.ImageTransparency = 0.6 + sin(t * 1.5) * 0.15
                inner.Size = UDim2.fromOffset(60 + sin(t * 2) * 15, 60 + sin(t * 2) * 15); inner.Rotation = t * 20
                for _, p in ipairs(sp) do
                    local a = p.a + t * p.s
                    p.f.Position = UDim2.fromOffset(W2 / 2 + cos(a) * p.r, H2 / 2 + sin(a) * p.r * 0.6)
                end
            end)
        end

        MYFX.rainfall = function(tok, W2, H2, th)
            emit(tok, 0.03, function()
                local x = rand() * W2 * 1.1
                local d = fr({ AnchorPoint = C, Rotation = 8, Position = UDim2.fromOffset(x, -20), Size = UDim2.fromOffset(1, rand(12, 26)),
                    BackgroundColor3 = rand() < 0.2 and th.Accent2 or th.Accent, BackgroundTransparency = 0.4 })
                local y = H2 * (0.6 + rand() * 0.4)
                local dur = 0.5 + rand() * 0.2
                tween(d, { Position = UDim2.fromOffset(x - y * 0.14, y) }, dur, LIN)
                task.delay(dur, function()
                    d:Destroy()
                    if fxTok ~= tok then return end
                    local r = circ(fr({ AnchorPoint = C, Position = UDim2.fromOffset(x - y * 0.14, y), Size = UDim2.fromOffset(2, 1), BackgroundTransparency = 1 }))
                    local st = new("UIStroke", { Color = th.Accent, Thickness = 1, Transparency = 0.5 }, r)
                    tween(r, { Size = UDim2.fromOffset(18, 7) }, 0.5); tween(st, { Transparency = 1 }, 0.5)
                    Debris:AddItem(r, 0.6)
                end)
            end)
        end

        MYFX.spotlights = function(tok, W2, H2, th)
            local bm = {}
            for i = 1, 3 do
                local b = fr({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new((i - 0.5) / 3, 0, -0.05, 0), Size = UDim2.new(0.2, 0, 1.4, 0),
                    BackgroundColor3 = th.Accent2, BackgroundTransparency = 0.8 })
                new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7),
                    NumberSequenceKeypoint.new(0.5, 0.88), NumberSequenceKeypoint.new(1, 1) }) }, b)
                bm[i] = { f = b, ph = i * 2.1 }
            end
            local dust = {}
            for i = 1, 18 do dust[i] = { f = circ(fr({ AnchorPoint = C, Position = UDim2.fromScale(rand(), rand()), Size = UDim2.fromOffset(2, 2), BackgroundColor3 = th.Accent2 })), ph = rand() * 6.28 } end
            loop(tok, function(t)
                for _, b in ipairs(bm) do b.f.Rotation = sin(t * 0.5 + b.ph) * 22 end
                for _, d in ipairs(dust) do d.f.BackgroundTransparency = 0.4 + sin(t + d.ph) * 0.4 end
            end, 0.04)
        end

        MYFX.pixelFall = function(tok, W2, H2, th)
            local cell = 16
            local cols = math.max(1, math.floor(W2 / cell))
            emit(tok, 0.18, function()
                local s = cell - 2
                local x = rand(0, cols - 1) * cell
                local b = fr({ Position = UDim2.fromOffset(x, -cell), Size = UDim2.fromOffset(s, s),
                    BackgroundColor3 = rand() < 0.5 and th.Accent or th.Accent2, BackgroundTransparency = 0.55 })
                local dur = 3 + rand() * 2
                task.spawn(function()
                    local steps = math.floor(H2 / cell) + 1
                    for i = 1, steps do
                        if fxTok ~= tok or not b.Parent then return end
                        b.Position = UDim2.fromOffset(x, i * cell - cell)
                        task.wait(dur / steps)
                    end
                    b:Destroy()
                end)
            end)
        end

        local function runMyThemeFx(themeName)
            clearFx()
            local fxName = THEME_FX[themeName]
            if not fxName or not MYFX[fxName] then return end
            local th = UI.Themes[themeName]
            if not th then return end
            local tok = fxTok
            local w, h = myLayer.AbsoluteSize.X, myLayer.AbsoluteSize.Y
            if w < 10 or h < 10 then
                task.wait(0.15)
                w, h = myLayer.AbsoluteSize.X, myLayer.AbsoluteSize.Y
            end
            task.spawn(MYFX[fxName], tok, w, h, th)
        end

        local lastTheme, lastOverride
        local conn = RunService.RenderStepped:Connect(function()
            if W.ThemeName ~= lastTheme then
                lastTheme = W.ThemeName
                if not W.FxOverride then task.defer(function() runMyThemeFx(lastTheme) end) end
            end
            if W.FxOverride ~= lastOverride then
                lastOverride = W.FxOverride
                if lastOverride then clearFx() else task.defer(function() runMyThemeFx(W.ThemeName) end) end
            end
            if myLayer then myLayer.Visible = (W.FxOverride == nil) end
        end)
        task.defer(function() runMyThemeFx(W.ThemeName) end)

        return W
    end
end

return UI
