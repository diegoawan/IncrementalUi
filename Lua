            accentGrad(headLine, 0)
            headLine.BackgroundColor3 = Color3.new(1, 1, 1)
            local headLineGrad = headLine:FindFirstChildOfClass("UIGradient")
            if headLineGrad then
                headLineGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
            end

            local Section = { Rows = {} }
            table.insert(Tab.Sections, { Frame = sf, Rows = Section.Rows, Pad = pad, Line = headLine })
            local order = 0

            local function ripple(r)
                local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
                local s = uiScale.Scale
                local lx, ly = (m.X - r.AbsolutePosition.X) / s, (m.Y - r.AbsolutePosition.Y) / s
                local fx = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10 }, r)
                corner(fx, 8)
