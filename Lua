    local function revealTitle(c)
        local t = new("TextLabel", {
            AnchorPoint = C, Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.new(1, -20, 0, 44),
            BackgroundTransparency = 1, Text = c.title, TextSize = 20, Font = Enum.Font.GothamBlack,
            TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1, ZIndex = 330,
        }, c.ov)
        new("UIStroke", { Color = c.th.Accent, Thickness = 2, Transparency = 0.35 }, t)
        tween(t, { TextTransparency = 0, TextSize = 34 }, 0.4, BACK)
        local bar = new("Frame", {
            AnchorPoint = C, Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(0, 2),
            BackgroundColor3 = c.th.Accent2, BorderSizePixel = 0, ZIndex = 330,
        }, c.ov)
        tween(bar, { Size = UDim2.fromOffset(120, 2) }, 0.45, QUART)
        if c.tag and c.tag ~= "" then
            local g = new("TextLabel", {
                AnchorPoint = C, Position = UDim2.fromScale(0.5, 0.56), Size = UDim2.new(1, -20, 0, 20),
                BackgroundTransparency = 1, Text = c.tag, TextSize = 14, Font = Enum.Font.GothamMedium,
                TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1, ZIndex = 330,
            }, c.ov)
            new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4 }, g)
            task.delay(0.2, function() tween(g, { TextTransparency = 0.1 }, 0.3) end)
        end
    end
    local function box(c, p, z) p.BorderSizePixel = 0; p.ZIndex = z or 302; return new("Frame", p, c.ov) end
    local function gl(c, p)
        p.BackgroundTransparency = 1; p.Image = GLOW; p.ZIndex = p.ZIndex or 302
        p.AnchorPoint = p.AnchorPoint or C
        return new("ImageLabel", p, c.ov)
    end
    local function fin(c, w) c.wait(w or 0.45); c.cover(); revealTitle(c); c.wait(0.8) end
    local function flash(c, col, a, d)
        local f = box(c, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col or Color3.new(1, 1, 1),
