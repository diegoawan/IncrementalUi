        Border = Color3.fromRGB(65,55,85)
    }
}

local Theme = Themes.White

--==================================================
-- UTILITIES
--==================================================

local function create(class, properties, parent)
    local object = Instance.new(class)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, object)
end

local function outline(object)
    create("UIStroke", {
        Color = Theme.Border,
        Thickness = 1
    }, object)
end

local function animate(object, properties, duration)
    TweenService:Create(
        object,
        TweenInfo.new(duration or 0.15),
        properties
    ):Play()
end

local function label(parent, text, size, color)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Text = text,
        TextColor3 = color or Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function button(parent, text, position, size)
    local object = create("TextButton", {
        Position = position or UDim2.new(),
        Size = size or UDim2.new(1,0,1,0),
        BackgroundColor3 = Theme.Element,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, parent)

    round(object, 5)

    object.MouseEnter:Connect(function()
        animate(object, {
            BackgroundColor3 = Theme.Border
        })
    end)

    object.MouseLeave:Connect(function()
        animate(object, {
            BackgroundColor3 = Theme.Element
        })
    end)

    return object
end

--==================================================
-- WINDOW
--==================================================

function IncrementalUi:CreateWindow(options)
    options = options or {}

    local ScreenGui = create("ScreenGui", {
        Name = "IncrementalUi",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Player:WaitForChild("PlayerGui"))

    local defaultSize = options.Size or UDim2.fromOffset(650,430)

    local Main = create("Frame", {
        Name = "Main",
        Size = defaultSize,
        Position = UDim2.new(0.5,-325,0.5,-215),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, ScreenGui)

    round(Main, 9)
    outline(Main)

    -- HEADER

    local Header = create("Frame", {
        Size = UDim2.new(1,0,0,42),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, Main)

    local Title = label(
        Header,
        options.Name or "IncrementalUi",
        UDim2.new(1,-110,1,0)
    )

    Title.Position = UDim2.fromOffset(15,0)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14

    local Close = button(
        Header,"×",
        UDim2.new(1,-38,0,6),
        UDim2.fromOffset(30,30)
    )

    local Minimize = button(
        Header,"−",
        UDim2.new(1,-74,0,6),
        UDim2.fromOffset(30,30)
    )

    -- DRAGGING (MOUSE + TOUCH)

    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = Main.Position
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            Main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input == dragInput
            or input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
            dragInput = nil
        end
    end)

    -- CONTENT LAYOUT

    local Sidebar = create("Frame", {
        Position = UDim2.fromOffset(0,42),
        Size = UDim2.new(0,145,1,-42),
        BackgroundColor3 = Theme.Sidebar,
        BorderSizePixel = 0
    }, Main)

    create("UIListLayout", {
        Padding = UDim.new(0,5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Sidebar)

    create("UIPadding", {
        PaddingTop = UDim.new(0,10),
        PaddingLeft = UDim.new(0,9),
        PaddingRight = UDim.new(0,9)
    }, Sidebar)

    local Content = create("Frame", {
        Position = UDim2.fromOffset(155,52),
        Size = UDim2.new(1,-165,1,-62),
        BackgroundTransparency = 1,
        BorderSizePixel = 0
    }, Main)

    -- SEARCH BAR

    local Search = create("TextBox", {
        Size = UDim2.new(1,-10,0,30),
        Position = UDim2.fromOffset(5,0),
        BackgroundColor3 = Theme.Element,
        Text = "",
        PlaceholderText = "Search components...",
        PlaceholderColor3 = Theme.Muted,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ClearTextOnFocus = false,
        BorderSizePixel = 0
    }, Content)

    round(Search,5)

    local PageContainer = create("Frame", {
        Position = UDim2.fromOffset(0,38),
        Size = UDim2.new(1,0,1,-38),
        BackgroundTransparency = 1
    }, Content)

    local Window = {
        ScreenGui = ScreenGui,
        Main = Main,
        Tabs = {},
        ActiveTab = nil,
        Config = {},
        Controls = {},
        Keybind = options.Keybind or Enum.KeyCode.RightControl
    }

    local function register(id, value, callback)
        if not id then return end

        Window.Config[id] = value

        Window.Controls[id] = {
            Set = callback
        }
    end

    --==================================================
    -- VISIBILITY / WINDOW CONTROLS
    --==================================================

    function Window:SetVisible(value)
        ScreenGui.Enabled = value
    end

    local minimized = false

    Close.Activated:Connect(function()
        ScreenGui:Destroy()
    end)

    Minimize.Activated:Connect(function()
        minimized = not minimized

        Sidebar.Visible = not minimized
        Content.Visible = not minimized

        Main.Size = minimized
            and UDim2.new(0,650,0,42)
            or defaultSize
    end)

    local windowKeyConnection = UIS.InputBegan:Connect(function(input, processed)
        if processed then return end

        if UIS:GetFocusedTextBox() then return end

        if input.KeyCode == Window.Keybind then
            ScreenGui.Enabled = not ScreenGui.Enabled
        end
    end)

    function Window:SetKeybind(key)
        Window.Keybind = key
    end

    --==================================================
    -- CUSTOM THEMES
    --==================================================

    local function applyTheme()
        Main.BackgroundColor3 = Theme.Background
        Header.BackgroundColor3 = Theme.Sidebar
        Sidebar.BackgroundColor3 = Theme.Sidebar
        Search.BackgroundColor3 = Theme.Element
        Search.TextColor3 = Theme.Text
        Search.PlaceholderColor3 = Theme.Muted
        Title.TextColor3 = Theme.Text

        for _, object in ipairs(ScreenGui:GetDescendants()) do
            if object:IsA("Frame") then
                if object:GetAttribute("ThemeSection") then
                    object.BackgroundColor3 = Theme.Section
                elseif object:GetAttribute("ThemeElement") then
                    object.BackgroundColor3 = Theme.Element
                end
            elseif object:IsA("TextLabel") then
                if object:GetAttribute("ThemeText") then
                    object.TextColor3 = Theme.Text
                elseif object:GetAttribute("ThemeMuted") then
                    object.TextColor3 = Theme.Muted
                elseif object:GetAttribute("ThemeAccent") then
                    object.TextColor3 = Theme.Accent
                end
            elseif object:IsA("TextButton") then
                if object:GetAttribute("ThemeElement") then
                    object.BackgroundColor3 = Theme.Element
                    object.TextColor3 = Theme.Text
                elseif object:GetAttribute("ThemeAccent") then
                    object.BackgroundColor3 = Theme.Accent
                end
            end
        end
    end

    function Window:SetTheme(theme)
        if typeof(theme) == "string" then
            if Themes[theme] then
                Theme = Themes[theme]
            else
                return false
            end
        elseif typeof(theme) == "table" then
            local newTheme = table.clone(Theme)

            for key, value in pairs(theme) do
                if typeof(newTheme[key]) == "Color3"
                    and typeof(value) == "Color3" then
                    newTheme[key] = value
                end
            end

            Theme = newTheme
        else
            return false
        end

        applyTheme()
        return true
    end

    --==================================================
    -- NOTIFICATIONS
    --==================================================

    local notificationCount = 0

    function Window:Notify(config)
        config = config or {}
        notificationCount += 1

        local notification = create("Frame", {
            Size = UDim2.fromOffset(260,65),
            Position = UDim2.new(1,280,1,-80-(notificationCount-1)*75),
            BackgroundColor3 = Theme.Section,
            BorderSizePixel = 0,
            ZIndex = 20
        }, ScreenGui)

        notification:SetAttribute("ThemeSection",true)
        round(notification,7)
        outline(notification)

        local heading = label(
            notification,
            config.Title or "Notification",
            UDim2.new(1,-20,0,25),
            Theme.Text
        )

        heading.Position = UDim2.fromOffset(10,5)
        heading.Font = Enum.Font.GothamBold
        heading.ZIndex = 21

        local description = label(
            notification,
            config.Content or "",
            UDim2.new(1,-20,0,25),
            Theme.Muted
        )

        description.Position = UDim2.fromOffset(10,30)
        description.ZIndex = 21

        animate(notification, {
            Position = UDim2.new(1,-275,1,-80-(notificationCount-1)*75)
        })

        task.delay(config.Duration or 3,function()
            if notification.Parent then
                animate(notification,{
                    Position = UDim2.new(1,280,1,-80)
                })

                task.wait(0.2)
                notification:Destroy()
                notificationCount = math.max(0,notificationCount-1)
            end
        end)

        return notification
    end

    --==================================================
    -- CONFIG SYSTEM
    --==================================================

    function Window:GetConfig()
        return table.clone(Window.Config)
    end

    function Window:ExportConfig()
        return HttpService:JSONEncode(Window.Config)
    end

    function Window:LoadConfig(data)
        if typeof(data) == "string" then
            local success, result = pcall(function()
                return HttpService:JSONDecode(data)
            end)

            if not success or typeof(result) ~= "table" then
                return false
            end

            data = result
        end

        if typeof(data) ~= "table" then
            return false
        end

        for id, value in pairs(data) do
            local control = Window.Controls[id]

            if control and control.Set then
                control.Set(value)
            end
        end

        return true
    end

    --==================================================
    -- SEARCH
    --==================================================

    Search:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(Search.Text)

        for _, tab in ipairs(Window.Tabs) do
            for _, section in ipairs(tab.Sections) do
                local visibleCount = 0

                for _, row in ipairs(section.Rows) do
                    local matches = string.find(
                        string.lower(row:GetAttribute("SearchText") or ""),
                        query,
                        1,
                        true
                    ) ~= nil

                    row.Visible = matches

                    if matches then
                        visibleCount += 1
                    end
                end

                section.Frame.Visible =
                    query == "" or visibleCount > 0
            end
        end
    end)

    --==================================================
    -- TABS
    --==================================================

    function Window:CreateTab(name)
        local tabButton = button(
            Sidebar,
            name,
            nil,
            UDim2.new(1,0,0,32)
        )

        tabButton:SetAttribute("ThemeElement",true)

        local tabFrame = create("ScrollingFrame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new()
        }, PageContainer)

        create("UIListLayout", {
            Padding = UDim.new(0,10),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, tabFrame)

        create("UIPadding", {
            PaddingTop = UDim.new(0,5),
            PaddingLeft = UDim.new(0,5),
            PaddingRight = UDim.new(0,5),
            PaddingBottom = UDim.new(0,10)
        }, tabFrame)

        tabFrame.Visible = false

        local Tab = {
            Frame = tabFrame,
            Button = tabButton,
            Sections = {}
        }

        function Tab:CreateSection(sectionName)
            local sectionFrame = create("Frame", {
                Size = UDim2.new(1,-5,0,35),
                BackgroundColor3 = Theme.Section,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.Y
            }, tabFrame)

            sectionFrame:SetAttribute("ThemeSection",true)
            round(sectionFrame,6)
            outline(sectionFrame)

            local heading = label(
                sectionFrame,
                sectionName,
                UDim2.new(1,-20,0,30),
                Theme.Accent
            )

            heading.Position = UDim2.fromOffset(10,0)
            heading.Font = Enum.Font.GothamBold
            heading:SetAttribute("ThemeAccent",true)

            local elements = create("Frame", {
                Position = UDim2.fromOffset(8,32),
                Size = UDim2.new(1,-16,0,0),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.Y
            },sectionFrame)

            create("UIListLayout", {
                Padding = UDim.new(0,7),
                SortOrder = Enum.SortOrder.LayoutOrder
            },elements)

            create("UIPadding", {
                PaddingBottom = UDim.new(0,9)
            },elements)

            local Section = {}

            local function makeRow(height,name,id)
                local row = create("Frame", {
                    Size = UDim2.new(1,0,0,height or 32),
                    BackgroundTransparency = 1
                },elements)

                row:SetAttribute("SearchText",name or "")

                table.insert(Section.Rows,row)

                return row
            end

            local function makeButton(parent,text,pos,size)
                local b = button(parent,text,pos,size)
                b:SetAttribute("ThemeElement",true)
                return b
            end

            -- BUTTON

            function Section:CreateButton(config)
                config = config or {}

                local row = makeRow(
                    32,config.Name,config.ConfigKey
                )

                local b = makeButton(row,config.Name or "Button")

                b.Activated:Connect(function()
                    if config.Callback then
                        task.spawn(config.Callback)
                    end
                end)

                return b
            end

            -- TOGGLE

            function Section:CreateToggle(config)
                config = config or {}

                local id = config.ConfigKey
                local value = config.CurrentValue == true

                local row = makeRow(32,config.Name,id)

                local title = label(
                    row,
                    config.Name or "Toggle",
                    UDim2.new(1,-65,1,0)
                )

                title:SetAttribute("ThemeText",true)

                local toggle = makeButton(
                    row,"",
                    UDim2.new(1,-42,0.5,-10),
                    UDim2.fromOffset(38,20)
                )

                local indicator = create("Frame", {
                    Size = UDim2.fromOffset(14,14),
                    Position = UDim2.fromOffset(3,3),
                    BackgroundColor3 = Theme.Muted,
                    BorderSizePixel = 0
                },toggle)

                round(indicator,4)

                local function setValue(newValue)
                    value = newValue == true

                    toggle.BackgroundColor3 = value
                        and Theme.Accent or Theme.Element

                    indicator.Position = value
                        and UDim2.new(1,-17,0,3)
                        or UDim2.fromOffset(3,3)

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value)
                    end
                end

                toggle.Activated:Connect(function()
                    setValue(not value)
                end)

                register(id,value,setValue)
                setValue(value)

                return {
                    SetValue = setValue,
                    GetValue = function() return value end
                }
            end

            -- SLIDER

            function Section:CreateSlider(config)
                config = config or {}

                local min = config.Range and config.Range[1] or 0
                local max = config.Range and config.Range[2] or 100
                local increment = config.Increment or 1

                assert(max > min,"Slider maximum must exceed minimum")

                local id = config.ConfigKey

                local value = math.clamp(
                    config.CurrentValue or min,min,max
                )

                local row = makeRow(48,config.Name,id)

                local title = label(
                    row,
                    config.Name or "Slider",
                    UDim2.new(1,-70,0,20)
                )

                title:SetAttribute("ThemeText",true)

                local valueLabel = label(
                    row,
                    tostring(value),
                    UDim2.fromOffset(65,20),
                    Theme.Accent
                )

                valueLabel.Position = UDim2.new(1,-65,0,0)
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel:SetAttribute("ThemeAccent",true)

                local bar = create("Frame", {
                    Position = UDim2.fromOffset(0,29),
                    Size = UDim2.new(1,0,0,7),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0
                },row)

                round(bar,5)

                local fill = create("Frame", {
                    Size = UDim2.new(0,0,1,0),
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel = 0
                },bar)

                round(fill,5)

                local function setValue(newValue)
                    value = math.clamp(
                        min + math.floor(
                            ((newValue-min)/increment)+0.5
                        )*increment,
                        min,max
                    )

                    local percent = (value-min)/(max-min)

                    fill.Size = UDim2.new(percent,0,1,0)
                    valueLabel.Text = tostring(value)

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value)
                    end
                end

                local active = false

                local function update(input)
                    local percent = math.clamp(
                        (input.Position.X-bar.AbsolutePosition.X)
                        /bar.AbsoluteSize.X,
                        0,1
                    )

                    setValue(min+(max-min)*percent)
                end

                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then

                        active = true
                        update(input)
                    end
                end)

                UIS.InputChanged:Connect(function(input)
                    if active and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        update(input)
                    end
                end)

                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        active = false
                    end
                end)

                register(id,value,setValue)
                setValue(value)

                return {
                    SetValue = setValue,
                    GetValue = function() return value end
                }
            end

            -- DROPDOWN

            function Section:CreateDropdown(config)
                config = config or {}

                local optionsList = config.Options or {}
                local selected = config.CurrentOption or optionsList[1]

                local id = config.ConfigKey

                local row = makeRow(32,config.Name,id)

                local title = label(
                    row,
                    config.Name or "Dropdown",
                    UDim2.new(0.42,0,1,0)
                )

                title:SetAttribute("ThemeText",true)

                local b = makeButton(
                    row,tostring(selected or "Select").."  ▾",
                    UDim2.new(0.43,0,0,0),
                    UDim2.new(0.57,0,1,0)
                )

                local menu
                local opened = false

                local function setValue(option)
                    if not table.find(optionsList,option) then
                        return
                    end

                    selected = option
                    b.Text = tostring(option).."  ▾"

                    if id then
                        Window.Config[id] = option
                    end

                    if config.Callback then
                        task.spawn(config.Callback,option)
                    end

                    if menu then
                        menu:Destroy()
                        menu = nil
                    end

                    opened = false
                end

                b.Activated:Connect(function()
                    opened = not opened

                    if not opened then
                        if menu then menu:Destroy() menu = nil end
                        return
                    end

                    menu = create("ScrollingFrame", {
                        Position = UDim2.new(0,0,1,3),
                        Size = UDim2.new(1,0,0,math.min(#optionsList*29,145)),
                        BackgroundColor3 = Theme.Section,
                        BorderSizePixel = 0,
                        ScrollBarThickness = 3,
                        CanvasSize = UDim2.new(0,0,0,#optionsList*29),
                        ZIndex = 10
                    },row)

                    round(menu,5)
                    outline(menu)

                    local layout = create("UIListLayout", {
                        Padding = UDim.new(0,2)
                    },menu)

                    for _,option in ipairs(optionsList) do
                        local item = create("TextButton", {
                            Size = UDim2.new(1,-6,0,27),
                            BackgroundColor3 = Theme.Element,
                            Text = tostring(option),
                            TextColor3 = Theme.Text,
                            Font = Enum.Font.Gotham,
                            TextSize = 11,
                            BorderSizePixel = 0,
                            ZIndex = 11
                        },menu)

                        item.Activated:Connect(function()
                            setValue(option)
                        end)
                    end
                end)

                register(id,selected,setValue)

                return {
                    SetValue = setValue,
                    GetValue = function() return selected end,
                    Refresh = function(_,newOptions)
                        optionsList = newOptions
                        if not table.find(optionsList,selected) then
                            selected = optionsList[1]
                            b.Text = tostring(selected or "Select").."  ▾"
                            if id then Window.Config[id] = selected end
                        end
                    end
                }
            end

            -- TEXTBOX

            function Section:CreateTextbox(config)
                config = config or {}

                local id = config.ConfigKey
                local value = config.CurrentValue or ""

                local row = makeRow(32,config.Name,id)

                local title = label(
                    row,
                    config.Name or "Textbox",
                    UDim2.new(0.4,0,1,0)
                )

                title:SetAttribute("ThemeText",true)

                local box = create("TextBox", {
                    Position = UDim2.new(0.42,0,0,0),
                    Size = UDim2.new(0.58,0,1,0),
                    BackgroundColor3 = Theme.Element,
                    Text = value,
                    PlaceholderText = config.PlaceholderText or "Enter text...",
                    PlaceholderColor3 = Theme.Muted,
                    TextColor3 = Theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    ClearTextOnFocus = false,
                    BorderSizePixel = 0
                },row)

                round(box,5)

                local function setValue(newValue)
                    value = tostring(newValue or "")
                    box.Text = value

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value,false)
                    end
                end

                box.FocusLost:Connect(function(enterPressed)
                    value = box.Text

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value,enterPressed)
                    end
                end)

                register(id,value,setValue)

                return box
            end

            -- KEYBIND

            function Section:CreateKeybind(config)
                config = config or {}

                local id = config.ConfigKey
                local key = config.CurrentKey or Enum.KeyCode.K
                local listening = false

                local row = makeRow(32,config.Name,id)

                local title = label(
                    row,
                    config.Name or "Keybind",
                    UDim2.new(0.6,0,1,0)
                )

                title:SetAttribute("ThemeText",true)

                local b = makeButton(
                    row,key.Name,
                    UDim2.new(1,-100,0,0),
                    UDim2.fromOffset(100,32)
                )

                local function setValue(newKey)
                    if typeof(newKey) ~= "EnumItem"
                        or newKey.EnumType ~= Enum.KeyCode then
                        return
                    end

                    key = newKey
                    b.Text = key.Name

                    if id then
                        Window.Config[id] = key.Name
                    end
                end

                b.Activated:Connect(function()
                    listening = true
                    b.Text = "Press a key..."
                end)

                local connection = UIS.InputBegan:Connect(function(input,processed)
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            setValue(input.KeyCode)
                            listening = false
                        end
                        return
                    end

                    if processed or UIS:GetFocusedTextBox() then
                        return
                    end

                    if input.UserInputType == Enum.UserInputType.Keyboard
                        and input.KeyCode == key then

                        if config.Callback then
                            task.spawn(config.Callback,key)
                        end
                    end
                end)

                register(id,key.Name,function(newValue)
                    if typeof(newValue) == "string" then
                        local success,result = pcall(function()
                            return Enum.KeyCode[newValue]
                        end)

                        if success and result then
                            setValue(result)
                        end
                    elseif typeof(newValue) == "EnumItem" then
                        setValue(newValue)
                    end
                end)

                return {
                    SetValue = setValue,
                    GetValue = function() return key end,
                    Disconnect = function()
                        connection:Disconnect()
                    end
                }
            end

            return Section
        end

        TabButton.Activated:Connect(function()
            Window.ActiveTab = Tab

            for _,existing in ipairs(Window.Tabs) do
                existing.Frame.Visible = false

                existing.Button.BackgroundColor3 = Theme.Element
                existing.Button.TextColor3 = Theme.Muted
            end

            tabFrame.Visible = true
            tabButton.BackgroundColor3 = Theme.Accent
            tabButton.TextColor3 = Theme.Text
        end)

        table.insert(Window.Tabs,Tab)

        if #Window.Tabs == 1 then
            tabButton:Activate()
        end

        return Tab
    end

    -- CLEANUP

    ScreenGui.Destroying:Connect(function()
        windowKeyConnection:Disconnect()
    end)

    return Window
end

return IncrementalUi
