local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&@"

local function cutTitle(c, y, soft)
    y = y or 0.47
    local t = new("TextLabel", {
        AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5, y), Size=UDim2.new(1,-20,0,44),
        BackgroundTransparency=1, Text="", TextSize=34, Font=Enum.Font.GothamBlack,
        TextColor3=WHITE, ZIndex=330,
    }, c.ov)
    new("UIStroke", {Color=BLACK, Thickness=2, Transparency=0.4}, t)
    local g = new("TextLabel", {
        AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5, y+0.075), Size=UDim2.new(1,-20,0,24),
        BackgroundTransparency=1, Text=c.tag or "", TextSize=14, Font=Enum.Font.GothamMedium,
        TextColor3=WHITE, TextTransparency=1, ZIndex=330,
    }, c.ov)
    new("UIStroke", {Color=BLACK, Thickness=1, Transparency=0.4}, g)
    task.spawn(function()
        if soft then
            t.Text = c.title; t.TextTransparency = 1
            tween(t, {TextTransparency=0}, 0.4)
        else
            local n = #c.title
            for k = 1, 12 do
                if c.skipped() or not t.Parent then break end
                local out = {}
                for i = 1, n do
                    local ch = string.sub(c.title, i, i)
                    if ch == " " or i/n <= (k/12) - 0.1 then out[i] = ch
                    else out[i] = string.sub(CHARS, rand(1, #CHARS), rand(1, #CHARS)) end
                end
                t.Text = table.concat(out)
                task.wait(0.03)
            end
            if t.Parent then t.Text = c.title end
        end
        if g.Parent then tween(g, {TextTransparency=0.05}, 0.3) end
    end)
end

