local function voice(base, vol, pitch)
    if not UI.MusicEnabled then return end
    local id = UI.Sounds[base]; if not id then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = math.clamp(vol * UI.MusicVolume * UI.SoundGain, 0, 10)
        s.PlaybackSpeed = math.clamp(pitch, 0.1, 4)
        s.Parent = SoundService
        s.Ended:Connect(function() s:Destroy() end)
        s:Play(); Debris:AddItem(s, 6)
    end)
end
local function kick() UI._beat = 1; UI._beatId += 1 end

local function playStep(st, i)
    local dv = st.drumVol or 1
    if st.drums then
        for key, pat in pairs(st.drums) do
            local idx = ((i-1) % #pat) + 1
            local ch = string.sub(pat, idx, idx)
            if ch ~= "." then
                local ins = INS[key]
                voice(ins[1], ins[3]*dv*(ch=="o" and 0.5 or 1), ins[2]*(0.97+rand()*0.06))
                if key == "K" then kick() end
            end
        end
    end
    if not (st.drums and st.drums.K) and (i-1)%4 == 0 then kick() end
    if st.bass then
        local n = st.bass[((i-1) % #st.bass) + 1]
        if n then voice("Bass", 0.85, 0.5 * 2^(n/12)) end
    end
    if st.mel then
        local n = st.mel[((i-1) % #st.mel) + 1]
        if n then voice("Ping", st.melVol or 0.5, (st.root or 1) * 2^(n/12)) end
    end
    if st.pad then
        local c = st.pad[((i-1) % (st.padLen or 64)) + 1]
        if c then for _, n in ipairs(c) do voice("Ping", st.padVol or 0.25, (st.root or 1)*0.5*2^(n/12)) end end
    end
end

RunService.Heartbeat:Connect(function(dt)
    UI._beat = math.max(0, UI._beat - dt*4)
    local now = os.clock()
    if Music.Playing and Music.Style then
        local st = Music.Style
        local stepDur = 60 / st.bpm / 4
        local guard = 0
        while now >= Music.Next and guard < 4 do
            local idx = Music.Step + 1
            if st.swing and Music.Step % 2 == 1 then
                task.delay(st.swing * stepDur, function() if Music.Style == st then playStep(st, idx) end end)
            else
                playStep(st, idx)
            end
            Music.Step += 1; Music.Next += stepDur; guard += 1
        end
        if guard == 4 then Music.Next = now + stepDur end
    elseif Music.Playing and Music.Sound then
        local ld = Music.Sound.PlaybackLoudness
        Music.avg = Music.avg * 0.95 + ld * 0.05
        if ld > Music.avg*1.4 and ld > 80 and now - Music.lastBeat > 0.22 then
            Music.lastBeat = now; kick()
        end
    end
end)

function UI:StopMusic()
    Music.Style, Music.Name, Music.Playing = nil, nil, false
    if Music.Sound then Music.Sound:Destroy(); Music.Sound = nil end
end
function UI:PlayMusic(name)
    UI:StopMusic()
    if not name or name == "Off" or name == "Auto" or not UI.MusicEnabled then return end
    local custom = UI.Tracks[name]
    if custom then
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = custom; s.Looped = true
            s.Volume = math.clamp(UI.MusicVolume * 1.5, 0, 10)
            s.Parent = SoundService; s:Play()
            Music.Sound = s
        end)
        Music.Name, Music.Playing = name, Music.Sound ~= nil
    elseif UI.MusicStyles[name] then
        Music.Style, Music.Name, Music.Step, Music.Next, Music.Playing = UI.MusicStyles[name], name, 0, os.clock()+0.1, true
    end
end
function UI:SetMusicVolume(v) UI.MusicVolume = v; if Music.Sound then Music.Sound.Volume = math.clamp(v*1.5, 0, 10) end end
function UI:GetMusicNames()
    local names, styles, custom = {"Auto","Off"}, {}, {}
    for k in pairs(UI.MusicStyles) do styles[#styles+1] = k end
    for k in pairs(UI.Tracks) do custom[#custom+1] = k end
    table.sort(styles); table.sort(custom)
    for _, k in ipairs(styles) do names[#names+1] = k end
    for _, k in ipairs(custom) do names[#names+1] = k end
    return names
end

