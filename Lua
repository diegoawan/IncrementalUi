function UI:CreateWindow(options)
    options = options or {}
    local themeName = options.Theme or "GrayBlack"
    local theme = table.clone(self.Themes[themeName] or self.Themes.GrayBlack)

    local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local cam = workspace.CurrentCamera
    local viewport = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local baseW, baseH = 700, 470
    local scale = mobile and math.min((viewport.X - 30) / baseW, (viewport.Y - 100) / baseH, 0.85) or math.min((viewport.X - 40) / baseW, (viewport.Y - 40) / baseH, 1)
    scale = math.max(scale, 0.55)

    local baseSize = options.Size or UDim2.fromOffset(baseW, baseH)

    local gui = new("ScreenGui", { Name = "IncrementalUi_" .. tostring(#self.Windows + 1), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, Player:WaitForChild("PlayerGui"))

    local main = new("Frame", {
        Name = "Main", Size = baseSize, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        BackgroundColor3 = theme.Background, BorderSizePixel = 0, ClipsDescendants = true,
    }, gui)
    round(main, 14); local mainGrad = gradient(main, theme.Grad1, theme.Grad2, 45); outline(main, theme.Border, 1.5, 0.15)

    local uiScale = new("UIScale", {Scale = scale}, main)

    local vignette = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(90, 90, 110), BackgroundTransparency = 0.9, BorderSizePixel = 0, ZIndex = 0 }, main)
    round(vignette, 14)
    new("UIGradient", { Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.7), NumberSequenceKeypoint.new(1, 1)}), Rotation = 90 }, vignette)

    local bats = {}
    for i = 1, 10 do table.insert(bats, spawnBat(main, theme)) end

    local startScale = uiScale.Scale
    uiScale.Scale = startScale * 0.85
    task.spawn(function() tw(uiScale, {Scale = startScale}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end)

    local header = new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = theme.Sidebar, BorderSizePixel = 0, ZIndex = 4 }, main)
    round(header, 14); gradient(header, theme.Grad1, theme.Grad2, 45)
    new("Frame", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14), BackgroundColor3 = theme.Sidebar, BorderSizePixel = 0, ZIndex = 4 }, header)

    local accentLine = new("Frame", { Size = UDim2.new(1, -28, 0, 2), Position = UDim2.new(0, 14, 1, -2), BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 5 }, header)
    round(accentLine, 999); gradient(accentLine, theme.Accent, theme.Glow, 0)

