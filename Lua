        new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(R * 2, 1), BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.85, BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
        new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(1, R * 2), BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.85, BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
        local lines = {}
        for i = 1, 14 do
            lines[i] = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = theme.Accent, BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
        end
        local blips = {}
        for i = 1, 9 do
            local f = dot(5, theme.Accent2)
            local a, r = rand() * math.pi * 2, R * (0.2 + rand() * 0.75)
            f.Position = UDim2.fromOffset(cx + math.cos(a) * r, cy + math.sin(a) * r)
            f.BackgroundTransparency = 1
            f.Parent = fxLayer
            blips[i] = { f = f, a = a, glow = 0 }
        end
        local ang = 0
        step(tok, function(dt)
            ang += dt * 1.5
            for i, l in ipairs(lines) do
                local a = ang - (i - 1) * 0.06
                setLine(l, cx, cy, cx + math.cos(a) * R, cy + math.sin(a) * R, i == 1 and 2 or 1)
                l.BackgroundTransparency = 0.15 + (i - 1) * 0.065
            end
            for _, bl in ipairs(blips) do
                local d = (ang - bl.a) % (math.pi * 2)
                if d < 0.12 and bl.glow < 0.3 then
                    bl.glow = 1
                    sfx("Ping", 0.3, 1.8 + bl.a * 0.1, 0.08)
                end
                bl.glow = math.max(0, bl.glow - dt * 0.5)
                bl.f.BackgroundTransparency = 1 - bl.glow * 0.95
                local s = 3 + bl.glow * 6
                bl.f.Size = UDim2.fromOffset(s, s)
            end
        end)
    end
