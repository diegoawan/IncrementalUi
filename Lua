    spin(submitGrad, 5)

    getBtn.MouseEnter:Connect(function() tween(getBtn, { BackgroundColor3 = theme.ElementHover }, 0.15) end)
    getBtn.MouseLeave:Connect(function() tween(getBtn, { BackgroundColor3 = theme.Element }, 0.15) end)
    submitBtn.MouseEnter:Connect(function() tween(submitBtn, { BackgroundTransparency = 0.12 }, 0.15) end)
    submitBtn.MouseLeave:Connect(function() tween(submitBtn, { BackgroundTransparency = 0 }, 0.15) end)

    getBtn.Activated:Connect(function()
        local ok = pcall(function() setclipboard(link) end)
        if ok then
            errorLbl.TextColor3 = theme.Success
            errorLbl.Text = "Link copied to clipboard."
        else
            errorLbl.TextColor3 = theme.Muted
            errorLbl.Text = link
        end
        errorLbl.TextTransparency = 0
    end)

    local function attempt()
        if isChecking then return end
        local enteredKey = box.Text:match("^%s*(.-)%s*$")
        if enteredKey == "" then
            errorLbl.Text = "Please enter a key."
            errorLbl.TextColor3 = theme.Danger
            errorLbl.TextTransparency = 0
            return
        end
        if type(verifyKey) ~= "function" then
            errorLbl.Text = "Verification unavailable."
            errorLbl.TextColor3 = theme.Danger
            errorLbl.TextTransparency = 0
            return
        end
        isChecking = true
        errorLbl.Text = "Checking key..."
        errorLbl.TextColor3 = theme.Muted
        errorLbl.TextTransparency = 0
        submitBtn.Text = "Checking..."
        task.spawn(function()
            local callOk, valid, message = pcall(verifyKey, enteredKey)
            if callOk and valid == true then
                errorLbl.TextColor3 = Color3.fromRGB(0, 0, 0)
                errorLbl.Text = "Authentication Successful!"
                boxStroke.Color = Color3.fromRGB(0, 0, 0)
                burst(card, card.AbsoluteSize.X / rootScale.Scale / 2, 250, theme.Success, 14, 60, 20)
                task.wait(0.7)
                tween(dim, { BackgroundTransparency = 1 }, 0.4)
                tween(root, { Position = UDim2.fromScale(0.5, 1.5) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.wait(0.5)
                if blur then blur:Destroy() end
                gui.Enabled = false
                gui:Destroy()
                if options.OnSuccess then options.OnSuccess() end
            else
                isChecking = false
                submitBtn.Text = "Submit"
                errorLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
                errorLbl.Text = callOk and (message or "Invalid or expired key") or "Server connection failed"
                errorLbl.TextTransparency = 0
                boxStroke.Color = Color3.fromRGB(255, 80, 80)
                task.spawn(function()
                    local origin = root.Position
                    for i = 1, 6 do
                        local dir = (i % 2 == 0) and 1 or -1
                        tween(root, { Position = origin + UDim2.fromOffset(dir * (10 - i), 0) }, 0.04)
                        task.wait(0.04)
                    end
                    tween(root, { Position = origin }, 0.1)
                end)
            end
        end)
    end
    submitBtn.Activated:Connect(attempt)
    box.FocusLost:Connect(function(enter) if enter then attempt() end end)
    return gui
end

