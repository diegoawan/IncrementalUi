        end
        local t = 0
        step(tok, function(dt)
            t += dt
            local b = UI._beat
            for _, r in ipairs(rects) do
                r.z += dt * (0.22 + b * 0.5)
                if r.z > 1 then r.z -= 1 end
                local z = r.z
                local s = (0.03 + z * z * 1.7) * W
                r.f.Size = UDim2.fromOffset(s, s * 0.62)
                r.f.Rotation = math.sin(t * 0.4) * 12 + z * 25
                r.st.Color = theme.Accent:Lerp(theme.Accent2, z)
                r.st.Thickness = 1 + z * 2.5
