do
    local RunService   = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")
    local SoundService = game:GetService("SoundService")
    local Debris       = game:GetService("Debris")

    UI.MusicEnabled, UI.AutoMusic, UI.ThemeSfxEnabled = false, false, false
    UI.SoundVolume, UI.SoundGain = 0.35, 1.2
    for _, p in pairs(UI.FxSfx) do p[4] = 0 end
    pcall(function() UI:StopMusic() end)

    local rand, sin, cos, pi = math.random, math.sin, math.cos, math.pi
    local C = Vector2.new(0.5, 0.5)
    local GLOW = "rbxassetid://6014261993"
    local SINE, QUART, QUAD, QUINT, BACK, LIN =
        Enum.EasingStyle.Sine, Enum.EasingStyle.Quart, Enum.EasingStyle.Quad,
        Enum.EasingStyle.Quint, Enum.EasingStyle.Back, Enum.EasingStyle.Linear

    local function new(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        o.Parent = parent
        return o
    end
    local function tween(o, props, dur, style, dir)
        local t = TweenService:Create(o,
            TweenInfo.new(dur or 0.2, style or QUINT, dir or Enum.EasingDirection.Out), props)
        t:Play()
        return t
    end
    local function circ(f) new("UICorner", { CornerRadius = UDim.new(1, 0) }, f) return f end
    local function line(parent, x1, y1, x2, y2, thick, col, z)
        local dx, dy = x2 - x1, y2 - y1
        return new("Frame", {
            AnchorPoint = C, Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thick),
            Rotation = math.deg(math.atan2(dy, dx)), BackgroundColor3 = col,
            BorderSizePixel = 0, ZIndex = z or 1,
        }, parent)
    end

    local function cP(soundKey, vol, pitch, chain, toPitch, toDur, life)
        if not UI.SoundEnabled then return end
        local id = UI.Sounds[soundKey]
        if not id then return end
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = id
            s.Volume = math.clamp((vol or 1) * UI.SoundVolume * UI.SoundGain, 0, 10)
            s.PlaybackSpeed = math.clamp(pitch or 1, 0.1, 4)
            for _, fx in ipairs(UI.Chains[chain or "none"] or {}) do
                local e = Instance.new(fx[1])
                for k, v in pairs(fx[2]) do pcall(function() e[k] = v end) end
                e.Parent = s
            end
            s.Parent = SoundService
            s:Play()
            if toPitch and toDur then
                TweenService:Create(s, TweenInfo.new(toDur, QUAD),
                    { PlaybackSpeed = math.clamp(toPitch, 0.1, 4) }):Play()
            end
            s.Ended:Connect(function() s:Destroy() end)
            Debris:AddItem(s, life or 6)
        end)
    end
    local function noteFreq(p, steps)
        local scale = p.sc or {0, 2, 3, 5, 7, 8, 10}
        local n = #scale
        local semi = scale[(steps % n) + 1] + math.floor(steps / n) * 12
        return (p.f or 1) * 2 ^ (semi / 12)
    end
    local function play(p, events)
        for _, e in ipairs(events) do
            task.delay(e.d or 0, function()
                local f = p.f or 1
                local pitch = e.n and noteFreq(p, e.n)
                    or e.r and f * (e.r[1] + rand() * (e.r[2] - e.r[1]))
                    or f * (e.m or 1)
                cP(e.k, (e.v or 1) * (p.v or 1), pitch, e.c or p.ch, e.tp and e.tp * f, e.td, e.l)
            end)
        end
    end
    local function arch(name, events) UI.SfxArchetypes[name] = function(p) play(p, events) end end
    local function notes(k, steps, gap, v, ch, start)
        local t = {}
        for i, s in ipairs(steps) do t[i] = { d = (start or 0) + (i - 1) * gap, k = k, v = v, n = s, c = ch } end
        return t
    end
    local function rep(n, gap, mk, start)
        local t = {}
        for i = 1, n do local e = mk(i); e.d = (start or 0) + (i - 1) * gap; t[i] = e end
        return t
    end
    local function cat(...)
        local out = {}
        for _, l in ipairs({...}) do for _, e in ipairs(l) do out[#out + 1] = e end end
        return out
    end

