    local function applySearch()
        local tab = Window.ActiveTab
        if not tab then return end
        local q = string.match(string.lower(searchBox.Text), "^%s*(.-)%s*$")
        for _, s in ipairs(tab.Sections) do
            local any = false
            for _, r in ipairs(s.Rows) do
                local vis = q == "" or (r.Text ~= "" and string.find(string.lower(r.Text), q, 1, true) ~= nil)
                r.Frame.Visible = vis
                if vis then any = true end
            end
            s.Frame.Visible = any or q == ""
        end
    end
    searchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)

    local typeToken = 0
    local function selectTab(tab)
        if Window.ActiveTab == tab then return end
        closeDropdown()
        local prev = Window.ActiveTab
        Window.ActiveTab = tab
        if prev then sfx("Snap", 0.3, 1.9) end
        if prev then
            prev.Page.Visible = false
            prev.Paint()
        end
        tab.Paint()
        moveSelector(tab, prev == nil)
        tab.Page.Position = UDim2.fromOffset(0, 14)
        tab.Page.Visible = true
        tween(tab.Page, { Position = UDim2.fromOffset(0, 0) }, 0.4)

        typeToken += 1
        local tok = typeToken
        local full = tab.Name
        tab.Title.Text = ""
        task.spawn(function()
            for i = 1, #full do
                if typeToken ~= tok then tab.Title.Text = full return end
                tab.Title.Text = string.sub(full, 1, i) .. "_"
                task.wait(0.03)
            end
            tab.Title.Text = full
        end)

        for i, sec in ipairs(tab.Sections) do
            sec.Frame.GroupTransparency = 1
            sec.Pad.PaddingLeft = UDim.new(0, 28)
            sec.Line.Size = UDim2.new(0, 0, 0, 1)
            task.delay((i - 1) * 0.07, function()
                if sec.Frame.Parent then
                    tween(sec.Frame, { GroupTransparency = 0 }, 0.45)
                    tween(sec.Pad, { PaddingLeft = UDim.new(0, 2) }, 0.55)
                    tween(sec.Line, { Size = UDim2.new(1, 10, 0, 1) }, 0.8)
                end
            end)
            for j, row in ipairs(sec.Rows) do
                if row.Anim and row.Frame.Parent then
                    row.Frame.BackgroundTransparency = 1
                    task.delay((i - 1) * 0.07 + j * 0.05, function()
                        if row.Frame.Parent then tween(row.Frame, { BackgroundTransparency = 0.2 }, 0.4) end
                    end)
                end
            end
        end
        applySearch()
    end

