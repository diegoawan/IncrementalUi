local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end
local function tween(o, props, dur, style, dir)
    local t = TweenService:Create(o, TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play(); return t
end
local function playerGui() return Player:WaitForChild("PlayerGui") end
local function accentSeq(t) return ColorSequence.new(t.Accent, t.Accent2) end
local function borderSeq(t)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, t.Accent), ColorSequenceKeypoint.new(0.3, t.Accent2),
        ColorSequenceKeypoint.new(0.55, t.Border), ColorSequenceKeypoint.new(0.85, t.Border),
        ColorSequenceKeypoint.new(1, t.Accent),
    })
end
local SHADOW = "rbxassetid://6014261993"
local function makeShadow(parent, grow, t)
    return new("ImageLabel", {
        Name="Shadow", AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
        Size=UDim2.new(1, grow, 1, grow), BackgroundTransparency=1, Image=SHADOW,
        ImageColor3=BLACK, ImageTransparency=t or 0.5,
        ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(49,49,450,450), ZIndex=0,
    }, parent)
end
local function burst(parent, x, y, color, count, dist, z)
    count, dist = count or 8, dist or 28
    for i = 1, count do
        local a = (i/count)*math.pi*2 + rand()*0.6
        local d = dist*(0.6 + rand()*0.7)
        local s = rand(3, 5)
        local p = new("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromOffset(x,y),
            Size=UDim2.fromOffset(s,s), BackgroundColor3=color, BorderSizePixel=0, ZIndex=z or 60}, parent)
        corner(p, 999)
        tween(p, {Position=UDim2.fromOffset(x+math.cos(a)*d, y+math.sin(a)*d), BackgroundTransparency=1, Size=UDim2.fromOffset(0,0)}, 0.5+rand()*0.25, Enum.EasingStyle.Quad)
        task.delay(0.85, function() p:Destroy() end)
    end
end

local function resolveTheme(name)
    if type(name) == "table" then
        local t = table.clone(UI.Themes.Graphite)
        for k, v in pairs(name) do if typeof(v) == "Color3" then t[k] = v end end
        if type(name.Fx) == "string" then t.Fx = name.Fx end
        return t
    end
    return table.clone(UI.Themes[name] or UI.Themes.Graphite)
end

