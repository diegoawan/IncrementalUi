local function resolveTheme(name)
    if type(name) == "table" then
        local t = table.clone(UI.Themes.Graphite)
        for k, v in pairs(name) do if typeof(v) == "Color3" then t[k] = v end end
        if type(name.Fx) == "string" then t.Fx = name.Fx end
        if typeof(name.Accent) == "Color3" and typeof(name.Accent2) ~= "Color3" then
            t.Accent2 = t.Accent:Lerp(rgb(120, 120, 140), 0.55)
        end
        return t
    end
    local n = UI.ThemeAliases[name] or name
    return table.clone(UI.Themes[n] or UI.Themes.Graphite)
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function tween(o, props, dur, style, dir)
    local t = TweenService:Create(o, TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end
local function playerGui() return Player:WaitForChild("PlayerGui") end
local function initialOf(name) return string.upper(string.sub(name or "I", 1, 1)) end
local function loadAvatar(imageLabel)
    task.spawn(function()
        local ok, img = pcall(function()
            return Players:GetUserThumbnailAsync(Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok and img and imageLabel.Parent then imageLabel.Image = img end
    end)
end
local function accentSeq(t) return ColorSequence.new(t.Accent, t.Accent2) end
local function borderSeq(t)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, t.Accent),
        ColorSequenceKeypoint.new(0.3, t.Accent2),
        ColorSequenceKeypoint.new(0.55, t.Border),
        ColorSequenceKeypoint.new(0.85, t.Border),
        ColorSequenceKeypoint.new(1, t.Accent),
    })
end
local function spin(grad, seconds)
    local tw = TweenService:Create(grad, TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = grad.Rotation + 360 })
    tw:Play()
    return tw
end

local SHADOW_IMAGE = "rbxassetid://6014261993"
local function makeShadow(parent, grow, transparency)
    return new("ImageLabel", {
        Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, grow, 1, grow), BackgroundTransparency = 1, Image = SHADOW_IMAGE,
        ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = transparency or 0.5,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 0,
    }, parent)
end
local function burst(parent, x, y, color, count, dist, z)
    count = count or 8
    dist = dist or 28
    for i = 1, count do
        local a = (i / count) * math.pi * 2 + math.random() * 0.6
        local d = dist * (0.6 + math.random() * 0.7)
        local s = math.random(3, 5)
        local p = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(s, s),
            BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 60,
        }, parent)
        corner(p, 999)
        tween(p, {
            Position = UDim2.fromOffset(x + math.cos(a) * d, y + math.sin(a) * d),
            BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0),
        }, 0.5 + math.random() * 0.25, Enum.EasingStyle.Quad)
        task.delay(0.85, function() p:Destroy() end)
    end
end
local function spawnBat(parent, opts)
    opts = opts or {}
    local size = opts.Size or math.random(22, 32)
    local z = opts.ZIndex or 1
    local holder = new("Frame", {
        Name = "Bat", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size),
        Position = UDim2.fromScale(math.random(), math.random()), BackgroundTransparency = 1, ZIndex = z,
    }, parent)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "🦇", TextSize = size,
        Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1),
        TextTransparency = opts.Transparency or (0.35 + math.random() * 0.25), ZIndex = z,
    }, holder)
    task.spawn(function()
        task.wait(math.random() * 1.2)
        local px = holder.Position.X.Scale
        while holder.Parent do
            local tx, ty = -0.05 + math.random() * 1.1, 0.05 + math.random() * 0.9
            local dur = 3 + math.random() * 3.5
            tween(holder, { Rotation = math.clamp((tx - px) * 40, -18, 18) }, 0.9, Enum.EasingStyle.Sine)
            tween(holder, { Position = UDim2.fromScale(tx, ty) }, dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(dur)
            px = tx
        end
    end)
    return holder
end

function UI:CreateKeySystem(options)
    options = options or {}
    local theme = resolveTheme(options.Theme or "GreyWhite")
    local verifyKey = options.Verify
    local link = options.GetKeyURL or "https://diegoawan.github.io/IncrementalUiGetKey/"
