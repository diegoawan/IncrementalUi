    FX.Constellation = function(tok)
        local N = 22
        local nodes = {}
        for i = 1, N do
            local d = dot(rand(3, 5), rand() < 0.5 and theme.Accent or theme.Accent2)
            d.Parent = fxLayer
            nodes[i] = { f = d, x = rand() * W, y = rand() * H, vx = (rand() - 0.5) * 26, vy = (rand() - 0.5) * 26 }
        end
        local lines = {}
        local function getLine(key)
            local l = lines[key]
            if not l then
                l = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = theme.Accent, BorderSizePixel = 0, ZIndex = 1, Visible = false }, fxLayer)
                lines[key] = l
            end
            return l
        end
        local R = 110
        step(tok, function(dt)
            local m = UIS:GetMouseLocation()
            local mx = (m.X - fxLayer.AbsolutePosition.X) / uiScale.Scale
            local my = (m.Y - fxLayer.AbsolutePosition.Y) / uiScale.Scale
            local mouseIn = mx > 0 and my > 0 and mx < W and my < H
            for _, n in ipairs(nodes) do
                n.x += n.vx * dt
                n.y += n.vy * dt
                if n.x < 0 or n.x > W then n.vx = -n.vx; n.x = math.clamp(n.x, 0, W) end
                if n.y < 0 or n.y > H then n.vy = -n.vy; n.y = math.clamp(n.y, 0, H) end
                if mouseIn then
                    local dx, dy = mx - n.x, my - n.y
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d < 140 and d > 1 then n.x += dx / d * dt * 30; n.y += dy / d * dt * 30 end
                end
                n.f.Position = UDim2.fromOffset(n.x, n.y)
            end
            for i = 1, N do
                local a = nodes[i]
                for j = i + 1, N do
                    local b = nodes[j]
                    local dx, dy = a.x - b.x, a.y - b.y
                    local d = math.sqrt(dx * dx + dy * dy)
                    local l = lines[i * 100 + j]
                    if d < R then
                        l = l or getLine(i * 100 + j)
                        l.Visible = true
                        setLine(l, a.x, a.y, b.x, b.y, 1)
                        l.BackgroundTransparency = 0.25 + (d / R) * 0.75
                    elseif l and l.Visible then
                        l.Visible = false
                    end
                end
                local key = 10000 + i
                local l = lines[key]
                local d = mouseIn and math.sqrt((a.x - mx) ^ 2 + (a.y - my) ^ 2) or 1e9
                if d < 150 then
                    l = l or getLine(key)
                    l.BackgroundColor3 = theme.Accent2
                    l.Visible = true
                    setLine(l, a.x, a.y, mx, my, 1.5)
                    l.BackgroundTransparency = 0.1 + d / 150 * 0.8
                elseif l and l.Visible then
                    l.Visible = false
                end
            end
        end)
    end
