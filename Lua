local function fold(m, lo, hi)
	while m < lo do m += 12 end
	while m > hi do m -= 12 end
	return m
end

local function compile(sp)
	local rng = Random.new(sp.seed)
	local sc, g = SC[sp.scale], GROOVES[sp.groove]
	local prog, rhythm = P[sp.pk], R[sp.rk]
	local hook, d = {}, rng:NextInteger(0, 2)
	local walk = { -2, -1, -1, 0, 1, 1, 2 }
	for s = 1, 16 do
		if string.sub(rhythm, s, s) == "x" then
			d = math.clamp(d + walk[rng:NextInteger(1, #walk)], -1, 4)
			hook[s] = d
		else
			hook[s] = false
		end
	end
	local mel, bass, pad, dr = {}, {}, {}, {}
	local step = 0
	for _, secName in ipairs(FORMS[sp.form or "pop"]) do
		local sec = SECS[secName]
		for bar, rd in ipairs(prog) do
			local last = bar == #prog
			local cs = { semi(sc, rd), semi(sc, rd + 2), semi(sc, rd + 4) }
			if sec.drums == "full" then cs[4] = semi(sc, rd + 6) end
			for k, v in ipairs(cs) do cs[k] = fold(v, -2, 12) end
			pad[step + 1] = cs
			local bn = fold(semi(sc, rd), -5, 6)
			for s = 1, 16 do
				local bch = g.b and string.sub(g.b, s, s) or "."
				bass[step + s] = (sec.bass and bch == "x") and bn or false
				local m = false
				if sec.mel == "hook" then
					local h = hook[s]
					if h then
						if last and s >= 13 then h += 2 end
						m = semi(sc, rd + h)
					end
				elseif sec.mel == "arp" then
					if (s - 1) % 4 == 0 then m = semi(sc, rd + ({ 0, 2, 4, 2 })[(s - 1) // 4 + 1]) end
				elseif sec.mel == "long" then
					if s == 1 then m = semi(sc, rd + 4) elseif s == 9 then m = semi(sc, rd + 2) end
				elseif s == 1 then
					m = semi(sc, rd + 4)
				end
				mel[step + s] = m and fold(m, sec.win[1], sec.win[2]) or false
			end
			for key, pat in pairs(g.d) do
				local out = pat
				if sec.drums == "off" then
					out = (key == "K") and "o.......o......." or DOTS
				elseif sec.drums == "thin" then
					if key == "H" then out = thin(pat) elseif key == "C" then out = DOTS end
					if last and key == "S" then out = "....x.....x.xxxx" end
				elseif sec.drums == "kick" then
					if not (key == "K" and bar == 1) then out = DOTS end
				elseif last and key == "S" then
					out = "....x...x.x.xxxx"
				end
				dr[key] = dr[key] or {}
				table.insert(dr[key], out)
			end
			step += 16
		end
	end
	for key, parts in pairs(dr) do dr[key] = table.concat(parts) end
	return {
		bpm = sp.bpm, swing = sp.swing, root = sp.root or 0.9, drumVol = 0.55, melVol = 0.42, padVol = 0.2,
		drums = dr, bass = bass, mel = mel, pad = pad, padLen = step,
	}
end

