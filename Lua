UI.Cutscenes = S

function UI.PlayCutscene(Win, name, apply)
	local key = UI.ThemeAliases[name] or name
	local th, meta = UI.Themes[key], UI.ThemeCut[key]
	local scene = meta and S[meta[1]]
	if not (th and scene) then
		apply()
		Win._cutBusy = false
		return
	end
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local ov = new("TextButton", {
		Name = "Cutscene", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, Text = "",
		AutoButtonColor = false, ZIndex = 300, ClipsDescendants = true,
	}, Win.ScreenGui)
	local skip, applied = false, false
	ov.Activated:Connect(function() skip = true end)
	local c = {
		ov = ov, th = th, name = key, title = string.upper(key), tag = meta[2] or "", glyph = meta[3],
		W = vp.X, H = vp.Y, R = math.max(vp.X, vp.Y) * 1.6,
	}
	c.skipped = function() return skip end
	c.wait = function(t)
		local e = os.clock() + t
		while os.clock() < e and not skip do task.wait() end
	end
	c.cover = function()
		if not applied then
			applied = true
			apply()
		end
	end
	c.solid = function(color, t)
		ov.BackgroundColor3 = color
		tween(ov, { BackgroundTransparency = 0 }, t or 0.3)
	end
	c.sound = function(a, f, ch) UI.PlaySfxRecipe(a, f, ch, key) end
	c.fade = function(t)
		local function f(o)
			local g = {}
			if o:IsA("GuiObject") then g.BackgroundTransparency = 1 end
			if o:IsA("TextLabel") or o:IsA("TextButton") then g.TextTransparency = 1 end
			if o:IsA("ImageLabel") then g.ImageTransparency = 1 end
			if next(g) then tween(o, g, t, Enum.EasingStyle.Quad) end
			if o:IsA("UIStroke") then tween(o, { Transparency = 1 }, t) end
		end
		f(ov)
		for _, d in ipairs(ov:GetDescendants()) do f(d) end
		c.wait(t)
	end
	task.spawn(function()
		local ok, err = pcall(scene, c)
		if not ok then warn("[IncrementalUi] cutscene error: " .. tostring(err)) end
		c.cover()
		c.fade(0.45)
		ov:Destroy()
		Win._cutBusy = false
	end)
end

local origCreate = UI.CreateWindow
function UI:CreateWindow(options)
	local W = origCreate(self, options)
	local origSet = W.SetTheme
	function W:SetTheme(name)
		if UI.CutscenesEnabled and type(name) == "string" and not W._cutBusy and name ~= W.ThemeName then
			W._cutBusy = true
			UI.PlayCutscene(W, name, function() origSet(W, name) end)
			return true
		end
		return origSet(W, name)
	end

	local st = W.Tabs[1]
	if st and st.CreateSection then
		local sec = st:CreateSection("Cutscenes & Theme Audio")
		sec:CreateToggle({ Name = "Theme Cutscenes", CurrentValue = UI.CutscenesEnabled, Callback = function(v) UI.CutscenesEnabled = v end })
		sec:CreateToggle({ Name = "Theme Signature Sounds", CurrentValue = UI.ThemeSfxEnabled, Callback = function(v) UI.ThemeSfxEnabled = v end })
		sec:CreateButton({
			Name = "Replay Theme Cutscene",
			Callback = function()
				if W._cutBusy then return end
				W._cutBusy = true
				UI.PlayCutscene(W, W.ThemeName, function() end)
			end,
		})
	end

	task.spawn(function()
		while not W.Destroyed and W.ScreenGui.Parent do
			local cfg = UI.ThemeSfx[W.ThemeName]
			local lo, hi = 2.5, 5
			if cfg then lo, hi = cfg.i[1], cfg.i[2] end
			task.wait(lo + rand() * (hi - lo))
			if cfg and UI.ThemeSfxEnabled and W.Visible and not W._cutBusy and not UI.Music.Playing then
				UI.PlayThemeSfx(W.ThemeName)
			end
		end
	end)
	return W
end

