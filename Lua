            function Section:CreateSlider(cfg)
                cfg = cfg or {}
                local min = cfg.Range and cfg.Range[1] or 0
                local max = cfg.Range and cfg.Range[2] or 100
                local step2 = cfg.Increment or 1
                assert(max > min, "Invalid slider range")
                local suffix = cfg.Suffix or ""
                local id = cfg.ConfigKey or cfg.Flag
                local decimals = 0
                local frac = string.match(tostring(step2), "%.(%d+)")
                if frac then decimals = #frac end
                local function snap(v)
                    v = math.clamp(min + math.floor((v - min) / step2 + 0.5) * step2, min, max)
                    return tonumber(string.format("%." .. decimals .. "f", v))
                end
                local value = snap(cfg.CurrentValue or min)

                local r = makeRow(54, cfg.Name, false)
                label(r, cfg.Name or "Slider", "Text", { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -120, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
                local disp = label(r, "", "Accent", { Position = UDim2.new(1, -114, 0, 8), Size = UDim2.fromOffset(100, 18), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right })

                local hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 20) }, r)
                local track = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 4), BorderSizePixel = 0 }, hit, { BackgroundColor3 = "Background" })
                corner(track, 999)
                local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1) }, track)
                corner(fill, 999)
                accentGrad(fill, 0)
                local thumb = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3 }, track)
                corner(thumb, 999)
                local thumbStroke = strokeT(thumb, "Accent", 2, 0)

                local active = false
                local function render(instant)
                    local pct = (value - min) / (max - min)
                    local d = instant and 0 or 0.1
                    tween(fill, { Size = UDim2.new(pct, 0, 1, 0) }, d, Enum.EasingStyle.Quad)
                    tween(thumb, { Position = UDim2.new(pct, 0, 0.5, 0) }, d, Enum.EasingStyle.Quad)
                    disp.Text = tostring(value) .. suffix
                    tween(thumbStroke, { Thickness = 4, Transparency = 0.5 }, 0.1)
                    task.delay(0.12, function()
                        if not active then tween(thumbStroke, { Thickness = 2, Transparency = 0 }, 0.25) end
                    end)
                end
                local function set(nv)
                    local snapped = snap(nv)
                    if snapped == value then return end
                    value = snapped
                    render(false)
                    tween(disp, { TextSize = 15 }, 0.08)
                    task.delay(0.09, function() tween(disp, { TextSize = 13 }, 0.15) end)
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value) end
                    sfx("Snap", 0.12, 1.4 + (value - min) / (max - min), 0.05)
                end

                local function fromInput(input)
                    local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
                    set(min + (max - min) * pct)
                end
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        active = true
                        tween(thumb, { Size = UDim2.fromOffset(16, 16) }, 0.12, Enum.EasingStyle.Back)
                        tween(thumbStroke, { Thickness = 5, Transparency = 0.6 }, 0.15)
                        fromInput(input)
                    end
                end)
                connect(UIS.InputChanged, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        fromInput(input)
                    end
                end)
                connect(UIS.InputEnded, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        active = false
                        tween(thumb, { Size = UDim2.fromOffset(12, 12) }, 0.12)
                        tween(thumbStroke, { Thickness = 2, Transparency = 0 }, 0.2)
                    end
                end)

                if id then Window.Controls[id] = { Set = set } end
                render(true)
                if id then Window.Config[id] = value end
                if cfg.Callback then task.spawn(cfg.Callback, value) end
                return { SetValue = set, GetValue = function() return value end }
            end

            function Section:CreateDropdown(cfg)
                cfg = cfg or {}
