    new("TextLabel", {Position=UDim2.fromOffset(74,24), Size=UDim2.new(1,-98,0,20), BackgroundTransparency=1,
        Text=options.Title or "Authentication", TextColor3=theme.Text, Font=Enum.Font.GothamBold, TextSize=16,
        TextXAlignment=Enum.TextXAlignment.Left}, card)
    new("TextLabel", {Position=UDim2.fromOffset(74,44), Size=UDim2.new(1,-98,0,18), BackgroundTransparency=1,
        Text=options.Subtitle or "Enter your key to continue", TextColor3=theme.Muted, Font=Enum.Font.Gotham,
        TextSize=12, TextXAlignment=Enum.TextXAlignment.Left}, card)

    local box = new("TextBox", {Position=UDim2.fromOffset(24,96), Size=UDim2.new(1,-48,0,40), BackgroundColor3=theme.Element,
        Text="", PlaceholderText="Enter your key", PlaceholderColor3=theme.Muted, TextColor3=theme.Text,
        Font=Enum.Font.GothamMedium, TextSize=13, ClearTextOnFocus=false, BorderSizePixel=0,
        TextXAlignment=Enum.TextXAlignment.Left}, card)
    corner(box, 8)
    new("UIPadding", {PaddingLeft=UDim.new(0,12), PaddingRight=UDim.new(0,12)}, box)
    local boxStroke = new("UIStroke", {Color=theme.Border, Thickness=1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, box)
    box.Focused:Connect(function() tween(boxStroke, {Color=theme.Accent, Thickness=1.5}, 0.2) end)
    box.FocusLost:Connect(function() tween(boxStroke, {Color=theme.Border, Thickness=1}, 0.2) end)

    local errorLbl = new("TextLabel", {Position=UDim2.fromOffset(24,140), Size=UDim2.new(1,-48,0,16),
        BackgroundTransparency=1, Text="", TextColor3=theme.Danger, Font=Enum.Font.Gotham, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left, TextTransparency=1}, card)

    local getBtn = new("TextButton", {Position=UDim2.fromOffset(24,166), Size=UDim2.new(0.38,-18,0,40),
        BackgroundColor3=theme.Element, Text="Get Key", TextColor3=theme.Text, Font=Enum.Font.GothamMedium,
        TextSize=13, BorderSizePixel=0, AutoButtonColor=false}, card)
    corner(getBtn, 8)
    new("UIStroke", {Color=theme.Border, Thickness=1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, getBtn)

    local submitBtn = new("TextButton", {Position=UDim2.new(0.38,6,0,166), Size=UDim2.new(0.62,-30,0,40),
        BackgroundColor3=WHITE, Text="Submit", TextColor3=theme.AccentText, Font=Enum.Font.GothamBold,
        TextSize=13, BorderSizePixel=0, AutoButtonColor=false}, card)
    corner(submitBtn, 8)
    new("UIGradient", {Color=accentSeq(theme), Rotation=0}, submitBtn)

    getBtn.Activated:Connect(function()
        local ok = pcall(function() setclipboard(link) end)
        errorLbl.TextColor3 = ok and theme.Success or theme.Muted
        errorLbl.Text = ok and "Link copied to clipboard." or link
        errorLbl.TextTransparency = 0
    end)

    local function attempt()
        if isChecking then return end
        local k = box.Text:match("^%s*(.-)%s*$")
        if k == "" then errorLbl.Text = "Please enter a key."; errorLbl.TextColor3 = theme.Danger; errorLbl.TextTransparency = 0; return end
        if type(verifyKey) ~= "function" then errorLbl.Text = "Verification unavailable."; errorLbl.TextColor3 = theme.Danger; errorLbl.TextTransparency = 0; return end
        isChecking = true
        errorLbl.Text = "Checking key..."; errorLbl.TextColor3 = theme.Muted; errorLbl.TextTransparency = 0
        submitBtn.Text = "Checking..."
        task.spawn(function()
            local ok, valid, msg = pcall(verifyKey, k)
            if ok and valid == true then
                errorLbl.Text = "Authentication Successful!"
                errorLbl.TextColor3 = theme.Success
                burst(card, card.AbsoluteSize.X / rootScale.Scale / 2, 250, theme.Success, 14, 60, 20)
                task.wait(0.7)
                tween(dim, {BackgroundTransparency=1}, 0.4)
                tween(root, {Position=UDim2.fromScale(0.5, 1.5)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.wait(0.5)
                gui:Destroy()
                if options.OnSuccess then options.OnSuccess() end
            else
                isChecking = false
                submitBtn.Text = "Submit"
                errorLbl.TextColor3 = theme.Danger
                errorLbl.Text = ok and (msg or "Invalid or expired key") or "Server connection failed"
                errorLbl.TextTransparency = 0
                local origin = root.Position
                for i = 1, 6 do
                    local dir = (i%2==0) and 1 or -1
                    tween(root, {Position=origin + UDim2.fromOffset(dir*(10-i), 0)}, 0.04)
                    task.wait(0.04)
                end
                tween(root, {Position=origin}, 0.1)
            end
        end)
    end
    submitBtn.Activated:Connect(attempt)
    box.FocusLost:Connect(function(enter) if enter then attempt() end end)
    return gui
end

-- ═══════════════════════════════════════════════════════════════
-- CREATE WINDOW
-- ═══════════════════════════════════════════════════════════════
function UI:CreateWindow(options)
    options = options or {}
    local theme = resolveTheme(options.Theme or "Graphite")
    local themeName = type(options.Theme) == "string" and options.Theme or "Custom"
    local windowName = options.Name or "IncrementalUi"

    local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local baseW, baseH = 660, 440
    local baseSize = options.Size or UDim2.fromOffset(baseW, baseH)
    local fullW = baseSize.X.Offset > 0 and baseSize.X.Offset or baseW
    local fullH = baseSize.Y.Offset > 0 and baseSize.Y.Offset or baseH
    local scale = math.clamp(math.min((vp.X-40)/fullW, (vp.Y-40)/fullH, mobile and 0.85 or 1), 0.55, 1)
    local HEADER_H, SIDEBAR_W = 44, 164

    local gui = new("ScreenGui", {Name="IncrementalUi_"..string.sub(HttpService:GenerateGUID(false),1,6),
        ResetOnSpawn=false, IgnoreGuiInset=true, DisplayOrder=100, ZIndexBehavior=Enum.ZIndexBehavior.Sibling}, playerGui())

    local bindings, hooks, conns = {}, {}, {}
    local function make(class, props, parent, themed)
        local o2 = new(class, props, nil)
        if themed then
            for prop, key in pairs(themed) do o2[prop] = theme[key]; bindings[#bindings+1] = {o2, prop, key} end
        end
        o2.Parent = parent
        return o2
    end
    local function onTheme(fn) hooks[#hooks+1] = fn end
    local function connect(sig, fn) local c = sig:Connect(fn); conns[#conns+1] = c; return c end
    local function label(parent, text, key, props)
        local p = {BackgroundTransparency=1, Text=text, Font=Enum.Font.GothamMedium, TextSize=13,
            TextXAlignment=Enum.TextXAlignment.Left, Size=UDim2.fromScale(1,1)}
        for k, v in pairs(props or {}) do p[k] = v end
        return make("TextLabel", p, parent, {TextColor3=key or "Text"})
    end

    local accentGrads, borderGrads = {}, {}
    local function accentGrad(parent, rot)
        local g = new("UIGradient", {Color=accentSeq(theme), Rotation=rot or 0}, parent)
        accentGrads[#accentGrads+1] = g; return g
    end

    local function refreshTheme()
        for i = #bindings, 1, -1 do
            local b = bindings[i]
            if b[1]:IsDescendantOf(gui) then tween(b[1], {[b[2]] = theme[b[3]]}, 0.3)
            else table.remove(bindings, i) end
        end
        for i = #accentGrads, 1, -1 do
            local g = accentGrads[i]
            if g.Parent then g.Color = accentSeq(theme) else table.remove(accentGrads, i) end
        end
        for _, fn in ipairs(hooks) do fn() end
    end

    local root = new("Frame", {Name="Root", Size=baseSize, AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5), BackgroundTransparency=1}, gui)
    local uiScale = new("UIScale", {Scale=scale*0.94}, root)
    makeShadow(root, 60, 1)

    local main = make("CanvasGroup", {Name="Main", Size=UDim2.fromScale(1,1), BorderSizePixel=0, GroupTransparency=1},
        root, {BackgroundColor3="Background"})
    corner(main, 12)
    local borderStroke = new("UIStroke", {Color=WHITE, Thickness=1.5, Transparency=0.1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, main)
    borderGrads[#borderGrads+1] = new("UIGradient", {Color=borderSeq(theme)}, borderStroke)

    local batLayer = new("Frame", {Name="Background", Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
        ClipsDescendants=true, ZIndex=1}, main)

    local Window = {ScreenGui=gui, Root=root, Main=main, Tabs={}, ActiveTab=nil, Config={}, NamedConfigs={},
        Controls={}, Theme=theme, ThemeName=themeName, Visible=true, Destroyed=false,
        Keybind=options.Keybind or Enum.KeyCode.RightControl, _dd=nil, _fpsLabel=nil,
        _autoSave=false, _trail=true, Fx="Matrix", FxOverride=options.Fx, _cutBusy=false}
    UI.Windows[#UI.Windows+1] = Window

    local fxLayer = new("Frame", {Name="Fx", Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=0}, batLayer)
    local fxToken = 0

    local function applyFx(fxName)
        fxToken += 1
        local tok = fxToken
        fxLayer:ClearAllChildren()
        Window.Fx = fxName
        if fxName == "None" or not fxName then return end
        -- Simplistic FX: emit some particles
        task.spawn(function()
            while fxToken == tok and fxLayer.Parent do
                local d = new("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Size=UDim2.fromOffset(rand(3,6), rand(3,6)),
                    Position=UDim2.fromScale(rand(), rand()), BackgroundColor3=theme.Accent,
                    BackgroundTransparency=0.5, BorderSizePixel=0, ZIndex=1}, fxLayer)
                corner(d, 999)
                tween(d, {Position=UDim2.fromScale(rand(), rand()), BackgroundTransparency=1}, 1+rand()*2, Enum.EasingStyle.Sine)
                Debris:AddItem(d, 3+rand())
                task.wait(0.08 + rand()*0.15)
            end
        end)
    end
    function Window:SetFx(name)
        Window.FxOverride = (name == "Theme Default" or name == nil) and nil or name
        applyFx(Window.FxOverride or theme.Fx or "Bats")
    end
    applyFx(options.Fx or theme.Fx or "Bats")

    -- Header
    local header = make("Frame", {Size=UDim2.new(1,0,0,HEADER_H), BorderSizePixel=0, ZIndex=5}, main, {BackgroundColor3="Sidebar"})
    make("Frame", {Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,1,-1), BorderSizePixel=0, ZIndex=5}, header, {BackgroundColor3="Border"})

    local logo = make("Frame", {Size=UDim2.fromOffset(22,22), Position=UDim2.fromOffset(14,11), BorderSizePixel=0, ZIndex=6,
        BackgroundColor3=WHITE}, header)
    corner(logo, 6)
    new("UIGradient", {Color=accentSeq(theme), Rotation=45}, logo)
    label(logo, string.upper(string.sub(windowName,1,1)), "AccentText", {Font=Enum.Font.GothamBold, TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=7})

    local titleLbl = label(header, windowName, "Text", {Position=UDim2.fromOffset(46,13), Size=UDim2.new(1,-200,0,18),
        Font=Enum.Font.GothamBold, TextSize=14, ZIndex=6})

    local function ctrlButton(text, xOffset, hoverKey)
        local b = make("TextButton", {Size=UDim2.fromOffset(28,28), Position=UDim2.new(1,xOffset,0.5,-14),
            Text=text, Font=Enum.Font.GothamMedium, TextSize=18, AutoButtonColor=false,
            BackgroundTransparency=1, BorderSizePixel=0, ZIndex=7}, header, {TextColor3="Muted", BackgroundColor3=hoverKey})
        corner(b, 6)
        b.MouseEnter:Connect(function() tween(b, {BackgroundTransparency=0, TextColor3=(hoverKey=="Danger") and WHITE or theme.Text}, 0.15) end)
        b.MouseLeave:Connect(function() tween(b, {BackgroundTransparency=1, TextColor3=theme.Muted}, 0.15) end)
        return b
    end
    local minimizeBtn = ctrlButton("−", -70, "Element")
    local closeBtn = ctrlButton("×", -38, "Danger")

    -- FPS
    if options.ShowFPS ~= false then
        local fpsLbl = label(header, "", "Muted", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-78,0.5,0),
            Size=UDim2.fromOffset(60,16), TextSize=11, TextXAlignment=Enum.TextXAlignment.Right, ZIndex=7})
        Window._fpsLabel = fpsLbl
        local frames, acc = 0, 0
        connect(RunService.RenderStepped, function(dt)
            frames += 1; acc += dt
            if acc >= 0.5 then
                local fps = math.floor(frames/acc + 0.5)
                fpsLbl.Text = fps .. " FPS"
                fpsLbl.TextColor3 = fps >= 50 and theme.Success or (fps >= 30 and theme.Warning or theme.Danger)
                frames, acc = 0, 0
            end
        end)
    end

    -- Dragging
    local dragging, dragInput, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragInput, dragStart, startPos = true, input, input.Position, root.Position
        end
    end)
    connect(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            tween(root, {Position=UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)}, 0.06, Enum.EasingStyle.Quad)
        end
    end)
    connect(UIS.InputEnded, function(input)
        if input == dragInput then dragging, dragInput = false, nil end
    end)

    -- Body
    local body = new("Frame", {Position=UDim2.fromOffset(0,HEADER_H), Size=UDim2.new(1,0,0,fullH-HEADER_H),
        BackgroundTransparency=1}, main)
    local sidebar = make("Frame", {Size=UDim2.new(0,SIDEBAR_W,1,0), BorderSizePixel=0, BackgroundTransparency=0.12},
        body, {BackgroundColor3="Sidebar"})

    local searchBox = make("TextBox", {Position=UDim2.fromOffset(10,10), Size=UDim2.new(1,-21,0,30), Text="",
        PlaceholderText="Search", Font=Enum.Font.Gotham, TextSize=12, ClearTextOnFocus=false,
        BorderSizePixel=0, TextXAlignment=Enum.TextXAlignment.Left}, sidebar,
        {BackgroundColor3="Element", TextColor3="Text", PlaceholderColor3="Muted"})
    corner(searchBox, 7)

    local tabList = make("ScrollingFrame", {Position=UDim2.fromOffset(0,50), Size=UDim2.new(1,-1,1,-50),
        BackgroundTransparency=1, BorderSizePixel=0, ScrollBarThickness=0,
        AutomaticCanvasSize=Enum.AutomaticSize.Y, CanvasSize=UDim2.new(),
        ScrollingDirection=Enum.ScrollingDirection.Y}, sidebar)
    new("UIListLayout", {Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder}, tabList)
    new("UIPadding", {PaddingLeft=UDim.new(0,8), PaddingRight=UDim.new(0,8), PaddingTop=UDim.new(0,2), PaddingBottom=UDim.new(0,8)}, tabList)

    local pagesHolder = new("Frame", {Position=UDim2.fromOffset(SIDEBAR_W,0), Size=UDim2.new(1,-SIDEBAR_W,1,0),
        BackgroundTransparency=1, ClipsDescendants=true}, body)

    local function closeDropdown()
        local d = Window._dd
        if not d then return end
        Window._dd = nil
        if d.backdrop then d.backdrop:Destroy() end
        if d.menu then local m = d.menu; tween(m, {Size=UDim2.fromOffset(m.AbsoluteSize.X/uiScale.Scale, 0)}, 0.15); task.delay(0.16, function() if m.Parent then m:Destroy() end end) end
    end

    function Window:SetTheme(name)
        local t = resolveTheme(name)
        for k, v in pairs(t) do theme[k] = v end
        Window.ThemeName = name
        refreshTheme()
        applyFx(Window.FxOverride or theme.Fx or "Bats")
        return true
    end

    local function selectTab(tab)
        if Window.ActiveTab == tab then return end
        closeDropdown()
        local prev = Window.ActiveTab
        Window.ActiveTab = tab
        if prev then prev.Page.Visible = false; prev.Paint() end
        tab.Paint()
        tab.Page.Visible = true
        tween(tab.Page, {Position=UDim2.fromOffset(0,0)}, 0.4)
    end

    local launcher
    local function showLauncher()
        if launcher then return end
        local b = make("TextButton", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(1,-44,1,-44),
            Size=UDim2.fromOffset(44,44), Text="", AutoButtonColor=false, BorderSizePixel=0, ZIndex=100},
            gui, {BackgroundColor3="Sidebar"})
        corner(b, 12)
        label(b, string.upper(string.sub(windowName,1,1)), "Accent", {Font=Enum.Font.GothamBold, TextSize=18,
            TextXAlignment=Enum.TextXAlignment.Center, ZIndex=101})
        b.Activated:Connect(function() Window:SetVisible(true) end)
        launcher = b
    end
    local function hideLauncher() if launcher then launcher:Destroy(); launcher = nil end end

    function Window:SetVisible(v)
        v = v == true
        if v == Window.Visible then return end
        Window.Visible = v
        closeDropdown()
        if v then
            hideLauncher()
            root.Visible = true
            tween(uiScale, {Scale=scale}, 0.45)
            tween(main, {GroupTransparency=0}, 0.25)
        else
            tween(uiScale, {Scale=scale*0.94}, 0.25)
            tween(main, {GroupTransparency=1}, 0.2)
            task.delay(0.26, function() root.Visible = false end)
            showLauncher()
        end
    end
    function Window:Toggle() Window:SetVisible(not Window.Visible) end
    function Window:SetKeybind(k) if typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then Window.Keybind = k end end

    closeBtn.Activated:Connect(function() Window:SetVisible(false) end)

    connect(UIS.InputBegan, function(input, processed)
        if processed or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == Window.Keybind then Window:Toggle() end
    end)

    -- Notifications
    local notifHolder = new("Frame", {AnchorPoint=Vector2.new(1,1), Position=UDim2.new(1,-18,1,-18),
        Size=UDim2.fromOffset(300,600), BackgroundTransparency=1, ZIndex=200}, gui)
    new("UIListLayout", {Padding=UDim.new(0,8), SortOrder=Enum.SortOrder.LayoutOrder,
        VerticalAlignment=Enum.VerticalAlignment.Bottom, HorizontalAlignment=Enum.HorizontalAlignment.Right}, notifHolder)
    local notifCount = 0

    function Window:Notify(cfg)
        cfg = cfg or {}
        local kind = cfg.Type or "Info"
        local colorKey = kind == "Success" and "Success" or kind == "Warning" and "Warning" or kind == "Error" and "Danger" or "Accent"
        local glyphTxt = kind == "Success" and "+" or kind == "Warning" and "!" or kind == "Error" and "x" or "i"
        local dur = cfg.Duration or 4
        local content = cfg.Content or ""
        local textH = 0
        if content ~= "" then
            local ok, s = pcall(function() return TextService:GetTextSize(content, 12, Enum.Font.Gotham, Vector2.new(240, 1000)) end)
            textH = ok and s.Y or 16
        end
        local h = 14 + 18 + (textH > 0 and (textH+4) or 0) + 16

        notifCount += 1
        local wrap = new("Frame", {Size=UDim2.fromOffset(300, h), BackgroundTransparency=1, LayoutOrder=notifCount}, notifHolder)
        local card = make("CanvasGroup", {Position=UDim2.new(1,40,0,0), Size=UDim2.fromScale(1,1),
            BorderSizePixel=0, GroupTransparency=1}, wrap, {BackgroundColor3="Section"})
        corner(card, 10)
        make("Frame", {Size=UDim2.new(0,3,1,0), BorderSizePixel=0}, card, {BackgroundColor3=colorKey})
        label(card, glyphTxt, colorKey, {Position=UDim2.fromOffset(14,10), Size=UDim2.fromOffset(18,18),
            Font=Enum.Font.GothamBold, TextSize=11, TextXAlignment=Enum.TextXAlignment.Center})
        label(card, cfg.Title or "Notification", "Text", {Position=UDim2.fromOffset(40,10),
            Size=UDim2.new(1,-52,0,18), Font=Enum.Font.GothamBold})
        if content ~= "" then
            label(card, content, "Muted", {Position=UDim2.fromOffset(40,32), Size=UDim2.new(1,-52,0,textH),
                Font=Enum.Font.Gotham, TextSize=12, TextWrapped=true, TextYAlignment=Enum.TextYAlignment.Top})
        end
        tween(card, {Position=UDim2.new(0,0,0,0)}, 0.55, Enum.EasingStyle.Back)
        tween(card, {GroupTransparency=0}, 0.3)
        task.delay(dur, function()
            tween(card, {Position=UDim2.new(1,40,0,0), GroupTransparency=1}, 0.3)
            task.wait(0.3)
            tween(wrap, {Size=UDim2.fromOffset(300, 0)}, 0.2)
            task.wait(0.2); wrap:Destroy()
        end)
    end

    function Window:GetConfig() return table.clone(Window.Config) end
    function Window:SaveConfig(name) Window.NamedConfigs[name] = Window:GetConfig(); return true end
    function Window:LoadConfig(data)
        if type(data) == "string" then
            local ok, r = pcall(function() return HttpService:JSONDecode(data) end)
            if not ok then if Window.NamedConfigs[data] then r = Window.NamedConfigs[data] else return false end end
            data = r
        end
        if type(data) ~= "table" then return false end
        for id, v in pairs(data) do
            local c = Window.Controls[id]
            if c and c.Set then c.Set(v) end
        end
        return true
    end

    -- CreateTab
    function Window:CreateTab(name, icon)
        local Tab = {Name=name, Sections={}, Index=#Window.Tabs+1}
        local btn = new("TextButton", {Size=UDim2.new(1,0,0,34), Text="", AutoButtonColor=false,
            BorderSizePixel=0, BackgroundTransparency=1, LayoutOrder=Tab.Index}, tabList)
        corner(btn, 7)
        local lbl = label(btn, name, "Muted", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-22,1,0),
            TextTruncate=Enum.TextTruncate.AtEnd})
        local hovering = false
        function Tab.Paint()
            local active = Window.ActiveTab == Tab
            tween(lbl, {TextColor3=(active or hovering) and theme.Text or theme.Muted}, 0.2)
        end
        onTheme(Tab.Paint)
        btn.MouseEnter:Connect(function() hovering = true; Tab.Paint() end)
        btn.MouseLeave:Connect(function() hovering = false; Tab.Paint() end)

        local page = make("ScrollingFrame", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, BorderSizePixel=0,
            Visible=false, ScrollBarThickness=3, AutomaticCanvasSize=Enum.AutomaticSize.Y,
            CanvasSize=UDim2.new(), ScrollingDirection=Enum.ScrollingDirection.Y}, pagesHolder,
            {ScrollBarImageColor3="Muted"})
        new("UIListLayout", {Padding=UDim.new(0,18), SortOrder=Enum.SortOrder.LayoutOrder}, page)
        new("UIPadding", {PaddingTop=UDim.new(0,16), PaddingLeft=UDim.new(0,18), PaddingRight=UDim.new(0,18), PaddingBottom=UDim.new(0,20)}, page)
        Tab.Title = label(page, name, "Text", {Size=UDim2.new(1,0,0,26), Font=Enum.Font.GothamBold, TextSize=19, LayoutOrder=0})
        Tab.Page, Tab.Button = page, btn
        function Tab:Select() selectTab(Tab) end
        btn.Activated:Connect(function() selectTab(Tab) end)

        function Tab:CreateSection(sectionName)
            local sf = new("CanvasGroup", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                BackgroundTransparency=1, LayoutOrder=#Tab.Sections+1}, page)
            new("UIPadding", {PaddingLeft=UDim.new(0,2), PaddingRight=UDim.new(0,2), PaddingTop=UDim.new(0,2), PaddingBottom=UDim.new(0,2)}, sf)
            new("UIListLayout", {Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder}, sf)
            label(sf, string.upper(sectionName or "Section"), "Muted", {Size=UDim2.new(1,0,0,20),
                Font=Enum.Font.GothamBold, TextSize=11, LayoutOrder=0})
            local Section = {Rows={}}
            table.insert(Tab.Sections, {Frame=sf, Rows=Section.Rows})
            local order = 0

            local function makeRow(height, text, clickable)
                order += 1
                local props = {Size=UDim2.new(1,0,0,height), BorderSizePixel=0, LayoutOrder=order, BackgroundTransparency=0.2}
                if clickable then props.Text = ""; props.AutoButtonColor = false end
                local r = make(clickable and "TextButton" or "Frame", props, sf, {BackgroundColor3="Element"})
                corner(r, 8)
                new("UIStroke", {Color=theme.Border, Thickness=1, Transparency=0.4, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, r)
                Section.Rows[#Section.Rows+1] = {Frame=r, Text=text or ""}
                r.MouseEnter:Connect(function() tween(r, {BackgroundColor3=theme.ElementHover}, 0.15) end)
                r.MouseLeave:Connect(function() tween(r, {BackgroundColor3=theme.Element}, 0.15) end)
                return r
            end

            function Section:CreateButton(cfg)
                cfg = cfg or {}
                local r = makeRow(38, cfg.Name, true)
                label(r, cfg.Name or "Button", "Text", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-26,1,0),
                    TextTruncate=Enum.TextTruncate.AtEnd})
                r.Activated:Connect(function() if cfg.Callback then task.spawn(cfg.Callback) end end)
                return {}
            end

            function Section:CreateToggle(cfg)
                cfg = cfg or {}
                local id = cfg.ConfigKey or cfg.Flag
                local value = cfg.CurrentValue == true
                local r = makeRow(38, cfg.Name, true)
                label(r, cfg.Name or "Toggle", "Text", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-70,1,0),
                    TextTruncate=Enum.TextTruncate.AtEnd})
                local track = new("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0),
                    Size=UDim2.fromOffset(38,20), BackgroundColor3=theme.Border, BorderSizePixel=0}, r)
                corner(track, 999)
                local knob = new("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,3,0.5,0),
                    Size=UDim2.fromOffset(14,14), BackgroundColor3=theme.Muted, BorderSizePixel=0}, track)
                corner(knob, 999)
                local function paint()
                    tween(track, {BackgroundColor3=value and theme.Accent or theme.Border}, 0.22)
                    tween(knob, {Position=value and UDim2.new(0,21,0.5,0) or UDim2.new(0,3,0.5,0),
                        BackgroundColor3=value and theme.AccentText or theme.Muted}, 0.22, Enum.EasingStyle.Back)
                end
                onTheme(paint)
                local function set(v)
                    value = v == true
                    paint()
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value) end
                end
                r.Activated:Connect(function() set(not value) end)
                if id then Window.Controls[id] = {Set=set} end
                paint()
                return {}
            end

            function Section:CreateSlider(cfg)
                cfg = cfg or {}
                local min = cfg.Range and cfg.Range[1] or 0
                local max = cfg.Range and cfg.Range[2] or 100
                local step2 = cfg.Increment or 1
                local id = cfg.ConfigKey or cfg.Flag
                local function snap(v) return math.clamp(min + math.floor((v-min)/step2 + 0.5)*step2, min, max) end
                local value = snap(cfg.CurrentValue or min)
                local r = makeRow(54, cfg.Name, false)
                label(r, cfg.Name or "Slider", "Text", {Position=UDim2.fromOffset(14,8), Size=UDim2.new(1,-120,0,18)})
                local disp = label(r, tostring(value), "Accent", {Position=UDim2.new(1,-114,0,8),
                    Size=UDim2.fromOffset(100,18), Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Right})
                local hit = new("TextButton", {Text="", AutoButtonColor=false, BackgroundTransparency=1,
                    Position=UDim2.fromOffset(14,28), Size=UDim2.new(1,-28,0,20)}, r)
                local track = make("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,0,0.5,0),
                    Size=UDim2.new(1,0,0,4), BorderSizePixel=0}, hit, {BackgroundColor3="Background"})
                corner(track, 999)
                local fill = new("Frame", {Size=UDim2.new(0,0,1,0), BorderSizePixel=0, BackgroundColor3=WHITE}, track)
                corner(fill, 999)
                new("UIGradient", {Color=accentSeq(theme), Rotation=0}, fill)
                local thumb = new("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0,0,0.5,0),
                    Size=UDim2.fromOffset(12,12), BackgroundColor3=WHITE, BorderSizePixel=0, ZIndex=3}, track)
                corner(thumb, 999)
                local active = false
                local function render()
                    local pct = (value-min)/(max-min)
                    tween(fill, {Size=UDim2.new(pct,0,1,0)}, 0.1)
                    tween(thumb, {Position=UDim2.new(pct,0,0.5,0)}, 0.1)
                    disp.Text = tostring(value)..(cfg.Suffix or "")
                end
                local function set(nv)
                    local s = snap(nv)
                    if s == value then return end
                    value = s; render()
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value) end
                end
                local function fromInput(input)
                    local pct = math.clamp((input.Position.X - track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1), 0, 1)
                    set(min + (max-min)*pct)
                end
                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        active = true; fromInput(input)
                    end
                end)
                connect(UIS.InputChanged, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        fromInput(input)
                    end
                end)
                connect(UIS.InputEnded, function(input)
                    if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        active = false
                    end
                end)
                if id then Window.Controls[id] = {Set=set} end
                render()
                return {}
            end

            function Section:CreateDropdown(cfg)
                cfg = cfg or {}
                local choices = cfg.Options or {}
                local selected = cfg.CurrentOption or choices[1]
                local id = cfg.ConfigKey or cfg.Flag
                local r = makeRow(38, cfg.Name, true)
                label(r, cfg.Name or "Dropdown", "Text", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-200,1,0)})
                local valueLbl = label(r, tostring(selected or "Select"), "Accent", {AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-34,0.5,0), Size=UDim2.fromOffset(170,18),
                    TextXAlignment=Enum.TextXAlignment.Right, TextTruncate=Enum.TextTruncate.AtEnd})
                local function set(option)
                    if table.find(choices, option) == nil then return end
                    selected = option; valueLbl.Text = tostring(option)
                    if id then Window.Config[id] = option end
                    if cfg.Callback then task.spawn(cfg.Callback, option) end
                    closeDropdown()
                end
                r.Activated:Connect(function()
                    if Window._dd and Window._dd.owner == r then closeDropdown(); return end
                    closeDropdown()
                    local s = uiScale.Scale
                    local mainAbs, rowAbs, rowSz = main.AbsolutePosition, r.AbsolutePosition, r.AbsoluteSize
                    local itemH, gap, padV = 28, 2, 6
                    local contentH = #choices * itemH + math.max(#choices-1, 0)*gap + padV*2
                    local menuH, menuW = math.min(contentH, 184), 210
                    local relX = (rowAbs.X - mainAbs.X + rowSz.X)/s - menuW - 6
                    local relY = (rowAbs.Y - mainAbs.Y + rowSz.Y)/s + 4
                    local backdrop = new("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
                        Text="", AutoButtonColor=false, ZIndex=50}, main)
                    backdrop.Activated:Connect(closeDropdown)
                    local menu = make("ScrollingFrame", {Position=UDim2.fromOffset(relX, relY), Size=UDim2.fromOffset(menuW, 0),
                        BorderSizePixel=0, ClipsDescendants=true, ScrollBarThickness=3,
                        CanvasSize=UDim2.new(0,0,0,contentH), ScrollingDirection=Enum.ScrollingDirection.Y, ZIndex=51},
                        main, {BackgroundColor3="Section"})
                    corner(menu, 8)
                    new("UIListLayout", {Padding=UDim.new(0,gap), SortOrder=Enum.SortOrder.LayoutOrder}, menu)
                    for i, option in ipairs(choices) do
                        local isSel = option == selected
                        local item = make("TextButton", {Size=UDim2.new(1,0,0,itemH), Text=tostring(option),
                            Font=Enum.Font.GothamMedium, TextSize=12, BorderSizePixel=0, AutoButtonColor=false,
                            LayoutOrder=i, ZIndex=52, TextXAlignment=Enum.TextXAlignment.Left},
                            menu, {BackgroundColor3=isSel and "Accent" or "Element", TextColor3=isSel and "Accent" or "Text"})
                        corner(item, 6)
                        item.MouseEnter:Connect(function() if not isSel then item.BackgroundTransparency = 0 end end)
                        item.MouseLeave:Connect(function() if not isSel then item.BackgroundTransparency = 1 end end)
                        item.Activated:Connect(function() set(option) end)
                    end
                    Window._dd = {menu=menu, backdrop=backdrop, owner=r}
                    tween(menu, {Size=UDim2.fromOffset(menuW, menuH)}, 0.25)
                end)
                if id then Window.Controls[id] = {Set=set} end
                return {}
            end

            function Section:CreateTextbox(cfg)
                cfg = cfg or {}
                local id = cfg.ConfigKey or cfg.Flag
                local value = cfg.CurrentValue or ""
                local r = makeRow(38, cfg.Name, false)
                label(r, cfg.Name or "Textbox", "Text", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-168,1,0)})
                local box = make("TextBox", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.fromOffset(150,26), Text=value, PlaceholderText=cfg.PlaceholderText or "Enter text...",
                    Font=Enum.Font.Gotham, TextSize=12, ClearTextOnFocus=false, BorderSizePixel=0,
                    TextXAlignment=Enum.TextXAlignment.Left}, r,
                    {BackgroundColor3="Background", TextColor3="Text", PlaceholderColor3="Muted"})
                corner(box, 6)
                local function set(nv)
                    value = tostring(nv or ""); box.Text = value
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value, false) end
                end
                box.FocusLost:Connect(function(enter)
                    value = box.Text
                    if id then Window.Config[id] = value end
                    if cfg.Callback then task.spawn(cfg.Callback, value, enter) end
                end)
                if id then Window.Controls[id] = {Set=set}; Window.Config[id] = value end
                return {}
            end

            function Section:CreateKeybind(cfg)
                cfg = cfg or {}
                local key = cfg.CurrentKey or Enum.KeyCode.K
                local id = cfg.ConfigKey or cfg.Flag
                local listening = false
                local r = makeRow(38, cfg.Name, false)
                label(r, cfg.Name or "Keybind", "Text", {Position=UDim2.fromOffset(14,0), Size=UDim2.new(1,-110,1,0)})
                local b = make("TextButton", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.fromOffset(92,26), Text=key.Name, Font=Enum.Font.GothamMedium, TextSize=12,
                    BorderSizePixel=0, AutoButtonColor=false}, r,
                    {BackgroundColor3="Background", TextColor3="Accent"})
                corner(b, 6)
                local function set(nk)
                    if typeof(nk) ~= "EnumItem" or nk.EnumType ~= Enum.KeyCode then return end
                    key = nk; b.Text = key.Name
                    if id then Window.Config[id] = key.Name end
                end
                b.Activated:Connect(function()
                    listening = true; b.Text = "Press a key"
                end)
                connect(UIS.InputBegan, function(input)
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode ~= Enum.KeyCode.Escape then set(input.KeyCode) end
                            listening = false; b.Text = key.Name
                        end
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
                        if cfg.Callback then task.spawn(cfg.Callback, key) end
                    end
                end)
                if id then Window.Controls[id] = {Set=set}; Window.Config[id] = key.Name end
                return {}
            end

            function Section:CreateLabel(cfg)
                local text = type(cfg) == "table" and (cfg.Text or cfg.Name) or cfg or ""
                order += 1
                local l = label(sf, text, "Muted", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                    Font=Enum.Font.Gotham, TextSize=12, TextWrapped=true, LayoutOrder=order,
                    TextYAlignment=Enum.TextYAlignment.Top})
                return {SetText=function(_, t) l.Text = t end}
            end

            function Section:CreateParagraph(cfg)
                cfg = cfg or {}
                order += 1
                local card = make("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                    BorderSizePixel=0, LayoutOrder=order, BackgroundTransparency=0.2}, sf, {BackgroundColor3="Element"})
                corner(card, 8)
                new("UIPadding", {PaddingLeft=UDim.new(0,14), PaddingRight=UDim.new(0,14), PaddingTop=UDim.new(0,10), PaddingBottom=UDim.new(0,12)}, card)
                new("UIListLayout", {Padding=UDim.new(0,4), SortOrder=Enum.SortOrder.LayoutOrder}, card)
                label(card, cfg.Title or "", "Text", {Size=UDim2.new(1,0,0,18), Font=Enum.Font.GothamBold, LayoutOrder=1})
                label(card, cfg.Content or "", "Muted", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                    Font=Enum.Font.Gotham, TextSize=12, TextWrapped=true, LayoutOrder=2, TextYAlignment=Enum.TextYAlignment.Top})
                return {}
            end

            return Section
        end

        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then task.defer(function() selectTab(Tab) end) end
        return Tab
    end

    -- Settings tab
    local settingsTab = Window:CreateTab("Settings")
    local appearanceSec = settingsTab:CreateSection("Appearance")
    appearanceSec:CreateDropdown({
        Name="Theme", Options=UI.ThemeOrder, CurrentOption=Window.ThemeName,
        Callback=function(v) Window:SetTheme(v) end,
    })
    appearanceSec:CreateDropdown({
        Name="Background Effect",
        Options={"Theme Default", "Bats", "Snow", "Sakura", "Embers", "Bubbles", "Matrix", "Stars",
                 "Aurora", "Grid", "Fireflies", "Rain", "Orbs", "Confetti", "Comets", "Ripples",
                 "Warp", "Vortex", "Lightning", "Constellation", "Fireworks", "Equalizer", "Waves",
                 "Glitch", "Helix", "Tunnel", "Radar", "Plasma", "Meteors", "RingViz", "BeatPulse",
                 "Disco", "Chaos", "None"},
        CurrentOption=Window.FxOverride or "Theme Default",
        Callback=function(v) Window:SetFx(v) end,
    })

    local utilitySec = settingsTab:CreateSection("Utility")
    utilitySec:CreateKeybind({Name="UI Toggle Keybind", CurrentKey=Window.Keybind, Callback=function(k) Window:SetKeybind(k) end})
    utilitySec:CreateToggle({Name="Anti-AFK", CurrentValue=UI.AntiAfk, Callback=function(v) UI.AntiAfk = v end})
    utilitySec:CreateButton({Name="Reset Window Position", Callback=function() tween(root, {Position=UDim2.fromScale(0.5, 0.5)}, 0.3, Enum.EasingStyle.Back) end})

    local soundSec = settingsTab:CreateSection("Sound")
    soundSec:CreateToggle({Name="Sound Effects", CurrentValue=UI.SoundEnabled, Callback=function(v) UI.SoundEnabled = v end})
    soundSec:CreateSlider({Name="Volume", Range={0,100}, Increment=5, Suffix="%", CurrentValue=UI.SoundVolume*100,
        Callback=function(v) UI.SoundVolume = v/100 end})

    local themesTab = Window:CreateTab("Themes")
    local infoSec = themesTab:CreateSection("All 75 Themes Available")
    infoSec:CreateLabel("Pick a theme from Settings or browse below.")

    local gallerySec = themesTab:CreateSection("Gallery")
    local gallery = new("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundTransparency=1, LayoutOrder=9999}, gallerySec.Frame)
    new("UIGridLayout", {CellSize=UDim2.fromOffset(104,108), CellPadding=UDim2.fromOffset(8,8), SortOrder=Enum.SortOrder.LayoutOrder}, gallery)
    for i, name in ipairs(UI.ThemeOrder) do
        local th = UI.Themes[name]
        local card = new("TextButton", {Size=UDim2.fromScale(1,1), BackgroundColor3=th.Background, Text="",
            AutoButtonColor=false, BorderSizePixel=0, LayoutOrder=i}, gallery)
        corner(card, 8)
        new("UIStroke", {Color=th.Accent, Thickness=2, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, card)
        local band = new("Frame", {Size=UDim2.new(1,0,0,8), BackgroundColor3=th.Accent, BorderSizePixel=0}, card)
        corner(band, 8)
        new("UIGradient", {Color=ColorSequence.new(th.Accent, th.Accent2)}, band)
        new("TextLabel", {Position=UDim2.fromOffset(8,14), Size=UDim2.new(1,-14,0,34), BackgroundTransparency=1,
            Text=name, TextWrapped=true, TextColor3=th.Text, Font=Enum.Font.GothamBold, TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top}, card)
        new("TextLabel", {Position=UDim2.new(0,8,1,-16), Size=UDim2.new(1,-14,0,12), BackgroundTransparency=1,
            Text="♪ "..(UI.ThemeMusic[name] or "—"), TextColor3=th.Muted, Font=Enum.Font.Gotham,
            TextSize=9, TextXAlignment=Enum.TextXAlignment.Left}, card)
        card.Activated:Connect(function()
            if Window._cutBusy then return end
            Window._cutBusy = true
            UI.PlayCutscene(Window, name, function() Window:SetTheme(name) end)
        end)
    end

    -- Initial entrance
    tween(uiScale, {Scale=scale}, 0.55, Enum.EasingStyle.Back)
    tween(main, {GroupTransparency=0}, 0.3)

    task.delay(0.5, function()
        Window:Notify({Title="IncrementalUi v"..UI.Version.." Loaded",
            Content="75 themes · 18 cutscenes · webhook sent",
            Type="Success", Duration=5})
    end)

    return Window
end

