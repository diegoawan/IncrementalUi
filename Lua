local function sfx(base, vol, pitch, cd)
    if not UI.SoundEnabled then return end
    local id = UI.Sounds[base]
    if not id then return end
    local now = os.clock()
    if now - (sfxLast[base] or 0) < (cd or 0.04) then return end
    sfxLast[base] = now
    local pack = UI.SoundPacks[UI.SoundPack] or { 1, 1 }
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = math.clamp((vol or 0.5) * UI.SoundVolume * UI.SoundGain * pack[2], 0, 10)
        s.PlaybackSpeed = math.clamp((pitch or 1) * pack[1], 0.2, 4)
        s.Parent = SoundService
        s.Ended:Connect(function() s:Destroy() end)
        s:Play()
        Debris:AddItem(s, 6)
    end)
end
