function UI:TestSounds()
    local lines, allOk = {}, true
    for name in pairs(UI.SoundCandidates) do
        local id = UI.Sounds[name]
        local ok, info = false, "no id"
        if id then
            local s = Instance.new("Sound")
            s.SoundId = id
            s.Volume = 1
            s.Parent = SoundService
            pcall(function() ContentProvider:PreloadAsync({ s }) end)
            pcall(function() s:Play() end)
            task.wait(0.4)
            ok = s.IsLoaded and s.TimeLength > 0
            info = ok and "ok" or "FAILED"
            s:Destroy()
        end
        if not ok then allOk = false end
        table.insert(lines, name .. ": " .. info)
    end
    table.sort(lines)
    return table.concat(lines, ", "), allOk
end

