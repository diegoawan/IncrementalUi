--==== UTILITIES ====--
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) return new("UICorner", {CornerRadius=UDim.new(0,r or 6)}, o) end
local function outline(o, c, t, tr) return new("UIStroke", {Color=c, Thickness=t or 1, Transparency=tr or 0}, o) end
local function gradient(o, c1, c2, rot)
    return new("UIGradient", {
        Color = ColorSequence.new({ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2)}),
        Rotation = rot or 90,
    }, o)
end
local function tw(o, props, dur, style, dir)
    local t = TweenService:Create(o, TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end
local function makeLabel(parent, text, size, color)
    return new("TextLabel", {
        BackgroundTransparency=1, Size=size, Text=text, TextColor3=color,
        Font=Enum.Font.Gotham, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
    }, parent)
end

local function attachRipple(btn, theme)
    btn.ClipsDescendants = true
    btn.Activated:Connect(function()
        local r = new("Frame", {
            Size = UDim2.fromOffset(0, 0), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.55,
            BorderSizePixel = 0, ZIndex = 50,
        }, btn)
        round(r, 999)
        local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
        tw(r, {Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1}, 0.55, Enum.EasingStyle.Quad)
        task.delay(0.6, function() if r.Parent then r:Destroy() end end)
    end)
end

local function attachHoverScale(btn, theme, amount)
    local scale = new("UIScale", {Scale = 1}, btn)
    local glow = outline(btn, theme.Accent, 0, 1)
    btn.MouseEnter:Connect(function()
        if btn:GetAttribute("Locked") then return end
        tw(scale, {Scale = amount or 1.02}, 0.15, Enum.EasingStyle.Quad)
        tw(glow, {Thickness = 1.5, Transparency = 0.45}, 0.2)
    end)
    btn.MouseLeave:Connect(function()
        if btn:GetAttribute("Locked") then return end
        tw(scale, {Scale = 1}, 0.15, Enum.EasingStyle.Quad)
        tw(glow, {Thickness = 0, Transparency = 1}, 0.2)
    end)
end

local function makeButton(parent, text, position, size, theme)
    local b = new("TextButton", {
        Position = position or UDim2.new(), Size = size or UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.Element, Text = text, TextColor3 = theme.Text,
        Font = Enum.Font.GothamMedium, TextSize = 13, BorderSizePixel = 0, AutoButtonColor = false,
    }, parent)
    round(b, 6)
    gradient(b, theme.Grad1, theme.Grad2, 90)
    attachRipple(b, theme)
    attachHoverScale(b, theme, 1.02)
    b.MouseEnter:Connect(function()
        if b:GetAttribute("Locked") then return end
        tw(b, {BackgroundColor3 = theme.Border}, 0.15)
    end)
    b.MouseLeave:Connect(function()
        if b:GetAttribute("Locked") then return end
        tw(b, {BackgroundColor3 = theme.Element}, 0.15)
    end)
    return b
end

local function burstSparkles(parent, color, count, baseSize)
    count = count or 12
    baseSize = baseSize or 4
    for _ = 1, count do
        local s = new("Frame", {
            Size = UDim2.fromOffset(baseSize, baseSize), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 100,
        }, parent)
        round(s, 999)
        local angle = math.random() * math.pi * 2
        local dist = 50 + math.random() * 70
        local dx, dy = math.cos(angle) * dist, math.sin(angle) * dist
        tw(s, {Position = UDim2.new(0.5, dx, 0.5, dy), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1}, 0.7 + math.random() * 0.4, Enum.EasingStyle.Quad)
        task.delay(1.2, function() if s.Parent then s:Destroy() end end)
    end
end

local function makeScrollable(parent, theme)
    return new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ClipsDescendants = true, ScrollingEnabled = true, ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable, ScrollBarThickness = 5,
        ScrollBarImageColor3 = theme.Accent, ScrollBarImageTransparency = 0.15,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0),
    }, parent)
end

local function watchCanvas(sf)
    local function update()
        if not sf.Parent then return end
        local h = sf.AbsoluteCanvasSize.Y
        if h > 0 and math.abs(sf.CanvasSize.Y.Offset - h) > 2 then sf.CanvasSize = UDim2.new(0, 0, 0, h) end
    end
    sf.ChildAdded:Connect(function(c)
        task.delay(0.05, update)
        if c:IsA("GuiObject") then c:GetPropertyChangedSignal("AbsoluteSize"):Connect(update) end
    end)
    for _, c in ipairs(sf:GetChildren()) do
        if c:IsA("GuiObject") then c:GetPropertyChangedSignal("AbsoluteSize"):Connect(update) end
    end
    task.spawn(function() while sf.Parent do update() task.wait(0.2) end end)
end

local function spawnBat(parent, theme)
    local bat = new("TextLabel", {
        Size = UDim2.fromOffset(40, 40), Position = UDim2.fromScale(math.random(), math.random()),
        BackgroundTransparency = 1, Text = "🦇", TextColor3 = theme.Glow, TextSize = math.random(24, 32),
        Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center, TextTransparency = 0.25, ZIndex = 1,
    }, parent)
    bat:SetAttribute("UIParticle", true)
    local baseRot = math.random(-15, 15)
    bat.Rotation = baseRot
    task.spawn(function()
        while bat.Parent do
            tw(bat, {Rotation = baseRot + 12}, 0.35, Enum.EasingStyle.Sine); task.wait(0.35)
            tw(bat, {Rotation = baseRot - 12}, 0.35, Enum.EasingStyle.Sine); task.wait(0.35)
        end
    end)
    task.spawn(function()
        while bat.Parent do
            local tx = 0.05 + math.random() * 0.9
            local ty = 0.05 + math.random() * 0.85
            local dur = 3 + math.random() * 3
            tw(bat, {Position = UDim2.fromScale(tx, ty), TextTransparency = 0.15 + math.random() * 0.3}, dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(dur + 0.2)
        end
    end)
    return bat
end

