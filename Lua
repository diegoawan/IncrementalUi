                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(lx, ly), Size = UDim2.fromOffset(0, 0),
                    BackgroundColor3 = theme.Accent, BackgroundTransparency = 0.8, BorderSizePixel = 0,
                }, fx)
                corner(dotF, 999)
                local d = math.max(r.AbsoluteSize.X, r.AbsoluteSize.Y) / s * 2.4
                tween(dotF, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.6, Enum.EasingStyle.Quad)
                task.delay(0.65, function() fx:Destroy() end)
            end

            local function shine(r)
                local fx = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11 }, r)
                corner(fx, 8)
                local sw = new("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 46, 2, 0), Position = UDim2.new(-0.1, 0, 0.5, 0),
                    Rotation = 20, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.82, BorderSizePixel = 0,
                }, fx)
                new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, sw)
                tween(sw, { Position = UDim2.new(1.1, 0, 0.5, 0) }, 0.55, Enum.EasingStyle.Quad)
                task.delay(0.6, function() fx:Destroy() end)
            end

            local function makeRow(height, text, clickable)
                order += 1
                local props = { Size = UDim2.new(1, 0, 0, height), BorderSizePixel = 0, LayoutOrder = order, BackgroundTransparency = 0.2 }
                if clickable then props.Text = "" props.AutoButtonColor = false end
                local r = make(clickable and "TextButton" or "Frame", props, sf, { BackgroundColor3 = "Element" })
                corner(r, 8)
                local st = strokeT(r, "Border", 1, 0.4)
                local edge = make("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 0),
                    BorderSizePixel = 0, ZIndex = 3,
                }, r, { BackgroundColor3 = "Accent" })
                corner(edge, 999)
                table.insert(Section.Rows, { Frame = r, Text = text or "", Anim = true })
                r.MouseEnter:Connect(function()
                    sfx("Snap", 0.08, 2.4, 0.06)
                    tween(r, { BackgroundColor3 = theme.ElementHover }, 0.15)
                    tween(st, { Color = theme.Accent, Transparency = 0.6 }, 0.2)
                    tween(edge, { Size = UDim2.fromOffset(3, math.floor(height * 0.55)) }, 0.25, Enum.EasingStyle.Back)
                end)
                r.MouseLeave:Connect(function()
                    tween(r, { BackgroundColor3 = theme.Element }, 0.15)
                    tween(st, { Color = theme.Border, Transparency = 0.4 }, 0.25)
                    tween(edge, { Size = UDim2.fromOffset(3, 0) }, 0.2)
                end)
                if clickable then
