        while topLine.Parent do
            topGrad.Offset = Vector2.new(-1, 0)
            tween(topGrad, { Offset = Vector2.new(1, 0) }, 2.8, Enum.EasingStyle.Linear)
            task.wait(3.4)
        end
    end)

    local logo = new("Frame", { Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(24, 24), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, card)
    corner(logo, 10)
