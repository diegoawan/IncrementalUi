    local title = makeLabel(header, options.Name or "IncrementalUi", UDim2.new(1, -140, 1, 0), theme.Text)
    title.Position = UDim2.fromOffset(48, 0); title.Font = Enum.Font.GothamBold; title.TextSize = 16
    local shimmer = new("UIGradient", { Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 150, 170)), ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 255, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 170))}), Offset = Vector2.new(-1, 0) }, title)
    task.spawn(function() while title.Parent do shimmer.Offset = Vector2.new(-1, 0); tw(shimmer, {Offset = Vector2.new(1, 0)}, 2.8, Enum.EasingStyle.Linear); task.wait(3.2) end end)

