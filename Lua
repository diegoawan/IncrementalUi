                local b = makeButton(row, key.Name, UDim2.new(1, -100, 0, 0), UDim2.fromOffset(100, 36), theme); b:SetAttribute("UIElement", true)
                local function set(nk) if typeof(nk) ~= "EnumItem" or nk.EnumType ~= Enum.KeyCode then return end; key = nk; b.Text = key.Name; if id then Window.Config[id] = key.Name end end
                local pulseStroke = outline(b, Color3.fromRGB(255, 100, 100), 0, 1)
                b.Activated:Connect(function()
                    listening = true; b.Text = "Press key..."
                    task.spawn(function()
                        while listening and b.Parent do tw(pulseStroke, {Thickness = 2, Transparency = 0.1}, 0.35); task.wait(0.35); tw(pulseStroke, {Transparency = 1}, 0.35); task.wait(0.35) end
                        if pulseStroke.Parent then tw(pulseStroke, {Thickness = 0, Transparency = 1}, 0.2) end
                    end)
                end)
                local conn = UIS.InputBegan:Connect(function(input, processed)
                    if listening then if input.UserInputType == Enum.UserInputType.Keyboard then set(input.KeyCode); listening = false end; return end
                    if processed or UIS:GetFocusedTextBox() then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then if config.Callback then task.spawn(config.Callback, key) end end
                end)
                if id then
                    Window.Controls[id] = { Set = function(v) if typeof(v) == "string" then local ok, r = pcall(function() return Enum.KeyCode[v] end); if ok and r then set(r) end else set(v) end end }
                end
                return {SetValue = set, GetValue = function() return key end, Disconnect = function() conn:Disconnect() end}
            end
            return Section
        end
        tabButton.Activated:Connect(function()
            closeDropdown(); Window.ActiveTab = Tab
            for _, t in ipairs(Window.Tabs) do
                t.Frame.Visible = false; t.Button:SetAttribute("Locked", false); t.Button.BackgroundTransparency = 1; t.Button.BackgroundColor3 = theme.Sidebar
                t.Label.TextColor3 = theme.TabText; t.Glow.Thickness = 0; t.Glow.Transparency = 1
            end
            tabButton:SetAttribute("Locked", true); tabButton.BackgroundColor3 = theme.TabBgActive; tabButton.BackgroundTransparency = 0
            label.TextColor3 = theme.TabTextActive; tw(glow, {Thickness = 2, Transparency = 0.5}, 0.3)
            frame.Visible = true; frame.Position = UDim2.fromOffset(18, 0); tw(frame, {Position = UDim2.fromOffset(0, 0)}, 0.28, Enum.EasingStyle.Quart)
            for i, section in ipairs(Tab.Sections) do
                local sf = section.Frame; sf.BackgroundTransparency = 1
                task.delay((i - 1) * 0.04, function() tw(sf, {BackgroundTransparency = 0}, 0.3) end)
            end
        end)
        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then task.defer(function() pcall(function() tabButton:Activate() end) end) end
        return Tab
    end
    gui.Destroying:Connect(function()
        Window.Destroyed = true; keyConnection:Disconnect(); closeDropdown()
        for i, ex in ipairs(UI.Windows) do if ex == Window then table.remove(UI.Windows, i) break end end
    end)
    return Window
end

return UI
