            local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(rr * 2, rr * 2), BackgroundTransparency = 1, ZIndex = 1 }, fxLayer)
