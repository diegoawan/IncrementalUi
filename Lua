    local submitBtn = new("TextButton", {
        Position = UDim2.new(0.38, 6, 0, 230), Size = UDim2.new(0.62, -30, 0, 40), BackgroundColor3 = Color3.new(1, 1, 1),
        Text = "Submit", TextColor3 = theme.AccentText, Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0, AutoButtonColor = false,
    }, card)
    corner(submitBtn, 8)
