        local function loop(tok, fn, step)
            task.spawn(function()
                while fxTok == tok and myLayer.Parent do
                    fn(os.clock())
                    task.wait(step or 0.033)
                end
            end)
        end
        local function emit(tok, gap, fn)
            task.spawn(function()
                while fxTok == tok and myLayer.Parent do
                    fn()
