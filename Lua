    FX.Meteors = function(tok)
        local ms = {}
        local function spawnMeteor()
            if #ms > 8 then return end
            local x, y = W * (0.2 + rand() * 0.9), -10
            local ang = math.rad(115 + rand() * 12)
            local sp = 300 + rand() * 220
            local head = dot(rand(4, 6), white)
            head.Position = UDim2.fromOffset(x, y)
            head.ZIndex = 2
            head.Parent = fxLayer
            local trail = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = theme.Accent2, BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
            new("UIGradient", { Transparency = NumberSequence.new({ nk(0, 1), nk(1, 0) }) }, trail)
            ms[#ms + 1] = { head = head, trail = trail, x = x, y = y, ang = ang, vx = math.cos(ang) * sp, vy = math.sin(ang) * sp, len = 80 + rand() * 70, ground = H * (0.55 + rand() * 0.4) }
            sfx("Switch", 0.25, 2.8 + rand())
        end
        task.spawn(function()
            while fxToken == tok and fxLayer.Parent do
                task.wait(0.7 + rand() * 1.6)
                if fxToken ~= tok then break end
                if Window.Visible then spawnMeteor() end
            end
        end)
        step(tok, function(dt)
            for i = #ms, 1, -1 do
                local m = ms[i]
                m.x += m.vx * dt
                m.y += m.vy * dt
                m.head.Position = UDim2.fromOffset(m.x, m.y)
                m.trail.Position = UDim2.fromOffset(m.x - math.cos(m.ang) * m.len / 2, m.y - math.sin(m.ang) * m.len / 2)
                m.trail.Size = UDim2.fromOffset(m.len, 3)
                m.trail.Rotation = math.deg(m.ang)
                if m.y >= m.ground or m.x < -20 then
                    if m.x > 0 then
                        burst(fxLayer, m.x, m.y, theme.Accent, 10, 40, 3)
                        sfx("Snap", 0.6, 0.5)
                        sfx("Bass", 0.7, 0.7)
                    end
                    m.head:Destroy()
                    m.trail:Destroy()
                    table.remove(ms, i)
                end
            end
        end)
    end
