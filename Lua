local function frame(props, parent)
	props.BorderSizePixel = 0
	return new("Frame", props, parent)
end
local function round(f) new("UICorner", { CornerRadius = UDim.new(1, 0) }, f) end
local function line(parent, x1, y1, x2, y2, thick, color, z)
	local dx, dy = x2 - x1, y2 - y1
	return new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thick), Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 305,
	}, parent)
end

local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&@"
local function title(c, y, soft)
	y = y or 0.47
	local function mk(size, dy, font)
		local l = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, y + dy), Size = UDim2.new(1, -20, 0, size + 10),
			BackgroundTransparency = 1, Text = "", TextSize = size, Font = font, TextColor3 = WHITE, ZIndex = 330,
		}, c.ov)
		new("UIStroke", { Color = BLACK, Thickness = 2, Transparency = 0.4 }, l)
		return l
	end
	local t = mk(34, 0, Enum.Font.GothamBlack)
	local g = mk(14, 0.075, Enum.Font.GothamMedium)
	g.Text = c.tag
	g.TextTransparency = 1
	task.spawn(function()
		if soft then
			t.Text = c.title
			t.TextTransparency = 1
			tween(t, { TextTransparency = 0 }, 0.4)
		else
			local n, steps = #c.title, 12
			for k = 1, steps do
				if c.skipped() or not t.Parent then break end
				local out = {}
				for i = 1, n do
					local ch = string.sub(c.title, i, i)
					if ch == " " or i / n <= (k / steps) - 0.1 then
						out[i] = ch
					else
						local r = rand(1, #CHARS)
						out[i] = string.sub(CHARS, r, r)
					end
				end
				t.Text = table.concat(out)
				task.wait(0.03)
			end
			if t.Parent then t.Text = c.title end
		end
		if g.Parent then tween(g, { TextTransparency = 0.05 }, 0.3) end
	end)
	return t, g
end

local S = {}

S.wipe = function(c)
	local n = 9
	c.sound("riser", 1.1)
	for i = 1, n do
		local b = frame({
			Position = UDim2.new((i - 1) / n, 0, -1, 0), Size = UDim2.new(1 / n, 1, 1, 0),
			BackgroundColor3 = (i % 2 == 0) and c.th.Accent or c.th.Accent2, ZIndex = 301,
		}, c.ov)
		task.delay((i - 1) * 0.05, function() tween(b, { Position = UDim2.new((i - 1) / n, 0, 0, 0) }, 0.38, Enum.EasingStyle.Quart) end)
	end
	c.wait(0.4 + n * 0.05)
	c.cover()
	title(c)
	c.sound("coin")
	c.wait(0.9)
end

S.glitch = function(c)
	local th = c.th
	c.ov.BackgroundColor3 = BLACK
	local cols = { th.Accent, th.Accent2, WHITE, rgb(255, 0, 60), rgb(0, 255, 255) }
	local live = {}
	for stepN = 1, 12 do
		for _, f in ipairs(live) do f:Destroy() end
		live = {}
		for _ = 1, 9 do
			live[#live + 1] = frame({
				Position = UDim2.fromScale(rand() * 0.6, rand()), Size = UDim2.new(0.2 + rand() * 0.8, 0, 0, rand(4, 46)),
				BackgroundColor3 = cols[rand(1, 5)], BackgroundTransparency = rand() * 0.4, ZIndex = 305,
			}, c.ov)
		end
		c.ov.BackgroundTransparency = stepN >= 7 and 0 or ((stepN % 2 == 0) and 0.1 or 0.5)
		if stepN % 3 == 1 then c.sound("stutter", 0.8 + rand()) end
		if stepN == 7 then
			c.cover()
			title(c)
		end
		c.wait(0.055)
	end
	for _, f in ipairs(live) do f:Destroy() end
	c.wait(0.5)
end

S.matrix = function(c)
	local th = c.th
	c.solid(th.Background, 0.25)
	local cols = 15
	c.sound("typewriter", 1.3)
	for i = 1, cols do
		local ls = {}
		for k = 1, 24 do
			local r = rand(1, #CHARS)
			ls[k] = string.sub(CHARS, r, r)
		end
		local l = new("TextLabel", {
			Position = UDim2.new((i - 1) / cols, 0, 0, -400), Size = UDim2.new(1 / cols, 0, 0, 380), BackgroundTransparency = 1,
			Text = table.concat(ls, "\n"), Font = Enum.Font.Code, TextSize = 15, TextColor3 = th.Accent,
			TextYAlignment = Enum.TextYAlignment.Bottom, ZIndex = 302,
		}, c.ov)
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ nk(0, 1), nk(1, 0) }) }, l)
		task.delay(rand() * 0.35, function() tween(l, { Position = UDim2.new((i - 1) / cols, 0, 1, 0) }, 1.2 + rand() * 0.4, Enum.EasingStyle.Linear) end)
	end
	c.wait(0.45)
