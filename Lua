local function lum(c) return 0.299*c.R + 0.587*c.G + 0.114*c.B end

local function addTheme(name, bg, a1, a2, fx, cut, tag, glyph, sfxRow, songRow)
    local light = lum(bg) > 0.6
    local th = {
        Background = bg,
        Sidebar = light and bg:Lerp(BLACK, 0.045) or bg:Lerp(WHITE, 0.035),
        Section = light and bg:Lerp(WHITE, 0.75) or bg:Lerp(WHITE, 0.07),
        Element = light and bg:Lerp(WHITE, 0.75) or bg:Lerp(WHITE, 0.11),
        ElementHover = light and bg:Lerp(WHITE, 0.4) or bg:Lerp(WHITE, 0.17),
        Border = light and bg:Lerp(BLACK, 0.16) or bg:Lerp(WHITE, 0.22),
        Accent = a1, Accent2 = a2,
        AccentText = lum(a1) > 0.55 and rgb(14,14,20) or WHITE,
        Text = light and bg:Lerp(BLACK, 0.9) or bg:Lerp(WHITE, 0.92),
        Muted = light and bg:Lerp(BLACK, 0.5) or bg:Lerp(WHITE, 0.5),
        Success = rgb(52,211,120), Warning = rgb(245,176,65), Danger = rgb(240,82,82),
        Fx = fx or "Bats",
    }
    UI.Themes[name] = th
    table.insert(UI.ThemeOrder, name)
    UI.ThemeCut[name] = {cut, tag, glyph}
    if sfxRow then UI.ThemeSfx[name] = sfxRow end
    if songRow then UI.ThemeMusic[name] = Song(name .. " Theme", songRow) end
end
UI.AddTheme = addTheme
local function sf(a, f, sc, ch, i1, i2, v)
    return {a=a, f=f or 1, sc=SC[sc or "minor"], ch=ch or "none", v=v or 1, i={i1 or 2.5, i2 or 5}}
end

