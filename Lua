
--[[
    IncrementalUi v2.0
    White Edition
    Original Luau UI Library

    Features:
    - Draggable window (mouse + touch)
    - Tabs and sections
    - Search bar
    - Buttons, toggles and sliders
    - Dropdowns and textboxes
    - Keybinds
    - Notifications
    - Custom themes
    - JSON config export/import
    - Window visibility keybind
]]

local IncrementalUi = {}

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer

--==================================================
-- THEMES
--==================================================

