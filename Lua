        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; dragInput = input; dragStart = input.Position; startPosition = main.Position end
    end)
    UIS.InputChanged:Connect(function(input)
