        local beams = {}
        for i = 1, 6 do
            local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = cols[i], BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
            new("UIGradient", { Transparency = NumberSequence.new({ nk(0, 0.55), nk(1, 1) }) }, f)
            beams[i] = { f = f, ph = i * 1.1, sp = 0.5 + rand() * 0.6, w = 40 + rand() * 30 }
        end
        local ball = dot(26, white)
        ball.Position = UDim2.fromOffset(px, 16)
        ball.ZIndex = 3
        ball.Parent = fxLayer
        spin(new("UIGradient", { Color = ColorSequence.new(white, rgb(110, 110, 140)) }, ball), 3)
        local strobe = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4 }, fxLayer)
        local t, lastId, count = 0, UI._beatId, 0
        step(tok, function(dt)
            t += dt
            local b = UI._beat
            for _, bm in ipairs(beams) do
                local ang = math.pi / 2 + math.sin(t * bm.sp + bm.ph) * 1.05
                local len = H * 1.5
                bm.f.Position = UDim2.fromOffset(px + math.cos(ang) * len / 2, 10 + math.sin(ang) * len / 2)
                bm.f.Size = UDim2.fromOffset(len, bm.w * (1 + b * 0.5))
                bm.f.Rotation = math.deg(ang)
                bm.f.BackgroundTransparency = 0.5 - b * 0.4
            end
            if UI._beatId ~= lastId then
                lastId = UI._beatId
                count += 1
                burst(fxLayer, px, 16, white, 6, 70, 5)
                if count % 4 == 1 then
                    strobe.BackgroundTransparency = 0.85
                    tween(strobe, { BackgroundTransparency = 1 }, 0.25)
