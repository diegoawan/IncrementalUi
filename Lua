    FX.Tunnel = function(tok)
        local n = 14
        local rects = {}
        for i = 1, n do
            local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(W / 2, H / 2), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, fxLayer)
