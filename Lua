function UI.PlayCutscene(Win, name, apply)
    local key = name
    local th, meta = UI.Themes[key], UI.ThemeCut[key]
    local scene = meta and CS[meta[1]]
    if not (th and scene) then apply(); Win._cutBusy = false; return end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local ov = new("TextButton", {Name="Cutscene", Size=UDim2.fromScale(1,1), BackgroundColor3=BLACK, BackgroundTransparency=1,
        Text="", AutoButtonColor=false, ZIndex=300, ClipsDescendants=true}, Win.ScreenGui)
    local skip, applied = false, false
    ov.Activated:Connect(function() skip = true end)
    local c = {ov=ov, th=th, name=key, title=string.upper(key), tag=meta[2] or "", glyph=meta[3],
        W=vp.X, H=vp.Y, R=math.max(vp.X, vp.Y)*1.6}
    c.skipped = function() return skip end
    c.wait = function(t)
        local e = os.clock() + t
        while os.clock() < e and not skip do task.wait() end
    end
    c.cover = function() if not applied then applied = true; apply() end end
    c.solid = function(color, t)
        ov.BackgroundColor3 = color
        tween(ov, {BackgroundTransparency=0}, t or 0.3)
    end
    c.sound = function(a, f, ch) UI.PlaySfxRecipe(a, f, ch, key) end
    task.spawn(function()
        local ok, err = pcall(scene, c)
        if not ok then warn("[IncrementalUi] cutscene error: " .. tostring(err)) end
        c.cover()
        tween(ov, {BackgroundTransparency=1}, 0.45)
        for _, d in ipairs(ov:GetDescendants()) do
            pcall(function()
                if d:IsA("GuiObject") then tween(d, {BackgroundTransparency=1}, 0.4) end
                if d:IsA("TextLabel") or d:IsA("TextButton") then tween(d, {TextTransparency=1}, 0.4) end
            end)
        end
        task.wait(0.5)
        ov:Destroy()
        Win._cutBusy = false
    end)
end

