--==================================================
-- UTILITIES
--==================================================

local function new(class, props, parent)
    local object = Instance.new(class)

    for key, value in pairs(props or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    new("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, object)
end

local function outline(object, color)
    return new("UIStroke", {
        Color = color,
        Thickness = 1
    }, object)
end

local function animate(object, properties, duration)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quart),
        properties
    )

    animation:Play()
    return animation
end

local function makeLabel(parent, text, size, color)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Text = text,
        TextColor3 = color,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function makeButton(parent, text, position, size, theme)
    local b = new("TextButton", {
        Position = position or UDim2.new(),
        Size = size or UDim2.new(1,0,1,0),
        BackgroundColor3 = theme.Element,
        Text = text,
        TextColor3 = theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, parent)

    round(b, 5)

    b.MouseEnter:Connect(function()
        animate(b, {
            BackgroundColor3 = theme.Border
        })
    end)

    b.MouseLeave:Connect(function()
        animate(b, {
            BackgroundColor3 = theme.Element
        })
    end)

    return b
end

--==================================================
-- WINDOW
--==================================================

function UI:CreateWindow(options)
    options = options or {}

    local themeName = options.Theme or "White"
    local theme = table.clone(self.Themes[themeName] or self.Themes.White)

    local mobile = UIS.TouchEnabled

    local windowSize = options.Size or (
        mobile
        and UDim2.new(0.94,0,0.75,0)
        or UDim2.fromOffset(650,430)
    )

    local gui = new("ScreenGui", {
        Name = "IncrementalUi_" .. tostring(#self.Windows + 1),
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, Player:WaitForChild("PlayerGui"))

    local main = new("Frame", {
        Name = "Main",
        Size = windowSize,
        AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.fromScale(0.5,0.5),
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, gui)

    round(main, 9)
    outline(main, theme.Border)

    -- HEADER

    local header = new("Frame", {
        Size = UDim2.new(1,0,0,42),
        BackgroundColor3 = theme.Sidebar,
        BorderSizePixel = 0
    }, main)

    local title = makeLabel(
        header,
        options.Name or "IncrementalUi",
        UDim2.new(1,-115,1,0),
        theme.Text
    )

    title.Position = UDim2.fromOffset(15,0)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14

    local minimize = makeButton(
        header, "−",
        UDim2.new(1,-74,0,6),
        UDim2.fromOffset(30,30), theme
    )

    local close = makeButton(
        header, "×",
        UDim2.new(1,-38,0,6),
        UDim2.fromOffset(30,30), theme
    )

    -- DRAGGING

    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragInput = input
            dragStart = input.Position
            startPosition = main.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

            local delta = input.Position - dragStart

            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging = false
            dragInput = nil
        end
    end)

    -- SIDEBAR

    local sidebar = new("Frame", {
        Position = UDim2.fromOffset(0,42),
        Size = UDim2.new(0,145,1,-42),
        BackgroundColor3 = theme.Sidebar,
        BorderSizePixel = 0
    }, main)

    new("UIListLayout", {
        Padding = UDim.new(0,5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, sidebar)

    new("UIPadding", {
        PaddingTop = UDim.new(0,10),
        PaddingLeft = UDim.new(0,9),
        PaddingRight = UDim.new(0,9)
    }, sidebar)

    -- CONTENT

    local content = new("Frame", {
        Position = UDim2.fromOffset(155,52),
        Size = UDim2.new(1,-165,1,-62),
        BackgroundTransparency = 1
    }, main)

    local search = new("TextBox", {
        Size = UDim2.new(1,-10,0,30),
        Position = UDim2.fromOffset(5,0),
        BackgroundColor3 = theme.Element,
        Text = "",
        PlaceholderText = "⌕  Search components...",
        PlaceholderColor3 = theme.Muted,
        TextColor3 = theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        ClearTextOnFocus = false,
        BorderSizePixel = 0
    }, content)

    round(search,5)

    local pages = new("Frame", {
        Position = UDim2.fromOffset(0,38),
        Size = UDim2.new(1,0,1,-38),
        BackgroundTransparency = 1
    }, content)

    local Window = {
        Main = main,
        ScreenGui = gui,
        Tabs = {},
        ActiveTab = nil,
        Config = {},
        NamedConfigs = {},
        Controls = {},
        Theme = theme,
        ThemeName = themeName,
        Keybind = options.Keybind or Enum.KeyCode.RightControl,
        Destroyed = false
    }

    table.insert(UI.Windows, Window)

    --==================================================
    -- VISIBILITY
    --==================================================

    local minimized = false

    function Window:SetVisible(value)
        gui.Enabled = value == true
    end

    function Window:SetKeybind(key)
        if typeof(key) == "EnumItem"
            and key.EnumType == Enum.KeyCode then
            Window.Keybind = key
        end
    end

    close.Activated:Connect(function()
        gui:Destroy()
    end)

    minimize.Activated:Connect(function()
        minimized = not minimized

        sidebar.Visible = not minimized
        content.Visible = not minimized

        animate(main, {
            Size = minimized
                and UDim2.new(windowSize.X.Scale,windowSize.X.Offset,0,42)
                or windowSize
        })
    end)

    local keyConnection = UIS.InputBegan:Connect(function(input, processed)
        if processed or UIS:GetFocusedTextBox() then
            return
        end

        if input.KeyCode == Window.Keybind then
            gui.Enabled = not gui.Enabled
        end
    end)

    --==================================================
    -- THEME MANAGER
    --==================================================

    function Window:SetTheme(name)
        local selected = UI.Themes[name]

        if not selected then
            return false
        end

        theme = table.clone(selected)
        Window.Theme = theme
        Window.ThemeName = name

        Window:RefreshTheme()

        return true
    end

    function Window:SetCustomTheme(custom)
        if typeof(custom) ~= "table" then
            return false
        end

        for key,value in pairs(custom) do
            if typeof(theme[key]) == "Color3"
                and typeof(value) == "Color3" then
                theme[key] = value
            end
        end

        Window.Theme = theme
        Window:RefreshTheme()

        return true
    end

    function Window:RefreshTheme()
        main.BackgroundColor3 = theme.Background
        header.BackgroundColor3 = theme.Sidebar
        sidebar.BackgroundColor3 = theme.Sidebar
        search.BackgroundColor3 = theme.Element
        search.TextColor3 = theme.Text
        title.TextColor3 = theme.Text

        for _,obj in ipairs(gui:GetDescendants()) do
            if obj:GetAttribute("UISection") then
                obj.BackgroundColor3 = theme.Section
            elseif obj:GetAttribute("UIElement") then
                obj.BackgroundColor3 = theme.Element
            elseif obj:GetAttribute("UIAccent") then
                if obj:IsA("TextLabel") then
                    obj.TextColor3 = theme.Accent
                else
                    obj.BackgroundColor3 = theme.Accent
                end
            elseif obj:GetAttribute("UIText") then
                obj.TextColor3 = theme.Text
            end

            if obj:IsA("UIStroke") then
                obj.Color = theme.Border
            end
        end
    end

    --==================================================
    -- NOTIFICATIONS
    --==================================================

    local notifications = {}
    local notificationWidth = 270

    function Window:Notify(config)
        config = config or {}

        local notification = new("Frame", {
            Size = UDim2.fromOffset(notificationWidth,72),
            Position = UDim2.new(1,notificationWidth+20,1,-85),
            BackgroundColor3 = theme.Section,
            BorderSizePixel = 0,
            ZIndex = 30
        },gui)

        notification:SetAttribute("UISection",true)
        round(notification,7)
        outline(notification,theme.Border)

        local heading = makeLabel(
            notification,
            config.Title or "Notification",
            UDim2.new(1,-20,0,25),
            theme.Text
        )

        heading.Position = UDim2.fromOffset(10,5)
        heading.Font = Enum.Font.GothamBold
        heading.ZIndex = 31
        heading:SetAttribute("UIText",true)

        local description = makeLabel(
            notification,
            config.Content or "",
            UDim2.new(1,-20,0,30),
            theme.Muted
        )

        description.Position = UDim2.fromOffset(10,32)
        description.TextWrapped = true
        description.ZIndex = 31

        table.insert(notifications,notification)

        local function reposition()
            for index,item in ipairs(notifications) do
                if item.Parent then
                    animate(item,{
                        Position = UDim2.new(
                            1,-notificationWidth-15,
                            1,-85-(index-1)*80
                        )
                    })
                end
            end
        end

        reposition()

        task.delay(config.Duration or 3,function()
            if not notification.Parent then return end

            animate(notification,{
                Position = UDim2.new(1,notificationWidth+20,1,-85)
            },0.2)

            task.wait(0.25)

            for index,item in ipairs(notifications) do
                if item == notification then
                    table.remove(notifications,index)
                    break
                end
            end

            notification:Destroy()
            reposition()
        end)

        return notification
    end

    --==================================================
    -- CONFIG MANAGER
    --==================================================

    function Window:GetConfig()
        return table.clone(Window.Config)
    end

    function Window:ExportConfig()
        return HttpService:JSONEncode(Window.Config)
    end

    function Window:SaveConfig(name)
        assert(type(name) == "string" and name ~= "",
            "Config name required")

        Window.NamedConfigs[name] = Window:GetConfig()
        return true
    end

    function Window:LoadConfig(data)
        if type(data) == "string" then
            local success,result = pcall(function()
                return HttpService:JSONDecode(data)
            end)

            if not success or type(result) ~= "table" then
                if Window.NamedConfigs[data] then
                    result = Window.NamedConfigs[data]
                else
                    return false
                end
            end

            data = result
        end

        if type(data) ~= "table" then
            return false
        end

        for id,value in pairs(data) do
            local control = Window.Controls[id]

            if control and control.Set then
                control.Set(value)
            end
        end

        return true
    end

    function Window:GetConfigs()
        local names = {}

        for name in pairs(Window.NamedConfigs) do
            table.insert(names,name)
        end

        table.sort(names)
        return names
    end

    function Window:DeleteConfig(name)
        Window.NamedConfigs[name] = nil
    end

    --==================================================
    -- SEARCH
    --==================================================

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(search.Text)

        for _,tab in ipairs(Window.Tabs) do
            for _,section in ipairs(tab.Sections) do
                local count = 0

                for _,row in ipairs(section.Rows) do
                    local text = string.lower(
                        row:GetAttribute("SearchText") or ""
                    )

                    local matches = query == ""
                        or string.find(text,query,1,true) ~= nil

                    row.Visible = matches

                    if matches then
                        count += 1
                    end
                end

                section.Frame.Visible = query == "" or count > 0
            end
        end
    end)

    --==================================================
    -- TAB CREATION
    --==================================================

    function Window:CreateTab(name,icon)
        local tabButton = makeButton(
            sidebar,
            (icon and (icon.."  ") or "")..name,
            nil,
            UDim2.new(1,0,0,34),
            theme
        )

        local frame = new("ScrollingFrame", {
            Size = UDim2.fromScale(1,1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new()
        },pages)

        frame.Visible = false

        new("UIListLayout", {
            Padding = UDim.new(0,10),
            SortOrder = Enum.SortOrder.LayoutOrder
        },frame)

        new("UIPadding", {
            PaddingTop = UDim.new(0,5),
            PaddingLeft = UDim.new(0,5),
            PaddingRight = UDim.new(0,5),
            PaddingBottom = UDim.new(0,10)
        },frame)

        local Tab = {
            Frame = frame,
            Button = tabButton,
            Sections = {}
        }

        function Tab:CreateSection(sectionName)
            local sectionFrame = new("Frame", {
                Size = UDim2.new(1,-5,0,35),
                BackgroundColor3 = theme.Section,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.Y
            },frame)

            sectionFrame:SetAttribute("UISection",true)
            round(sectionFrame,6)
            outline(sectionFrame,theme.Border)

            local heading = makeLabel(
                sectionFrame,
                sectionName,
                UDim2.new(1,-20,0,30),
                theme.Accent
            )

            heading.Position = UDim2.fromOffset(10,0)
            heading.Font = Enum.Font.GothamBold
            heading:SetAttribute("UIAccent",true)

            local elements = new("Frame", {
                Position = UDim2.fromOffset(8,32),
                Size = UDim2.new(1,-16,0,0),
                BackgroundTransparency = 1,
                AutomaticSize = Enum.AutomaticSize.Y
            },sectionFrame)

            new("UIListLayout", {
                Padding = UDim.new(0,7),
                SortOrder = Enum.SortOrder.LayoutOrder
            },elements)

            new("UIPadding", {
                PaddingBottom = UDim.new(0,9)
            },elements)

            local Section = {Rows = {}}

            table.insert(Tab.Sections,{
                Frame = sectionFrame,
                Rows = Section.Rows
            })

            local function makeRow(height,name)
                local row = new("Frame",{
                    Size = UDim2.new(1,0,0,height or 32),
                    BackgroundTransparency = 1
                },elements)

                row:SetAttribute("SearchText",name or "")
                table.insert(Section.Rows,row)

                return row
            end

            -- BUTTON

            function Section:CreateButton(config)
                config = config or {}

                local row = makeRow(32,config.Name)

                local b = makeButton(
                    row,
                    config.Name or "Button",
                    nil,nil,theme
                )

                b:SetAttribute("UIElement",true)

                b.Activated:Connect(function()
                    if config.Callback then
                        task.spawn(config.Callback)
                    end
                end)

                return b
            end

            -- TOGGLE

            function Section:CreateToggle(config)
                config = config or {}

                local id = config.ConfigKey
                local value = config.CurrentValue == true

                local row = makeRow(32,config.Name)

                local title = makeLabel(
                    row,
                    config.Name or "Toggle",
                    UDim2.new(1,-65,1,0),
                    theme.Text
                )

                title:SetAttribute("UIText",true)

                local b = makeButton(
                    row,"",
                    UDim2.new(1,-42,0.5,-10),
                    UDim2.fromOffset(38,20),theme
                )

                b:SetAttribute("UIElement",true)

                local dot = new("Frame",{
                    Size = UDim2.fromOffset(14,14),
                    Position = UDim2.fromOffset(3,3),
                    BackgroundColor3 = theme.Muted,
                    BorderSizePixel = 0
                },b)

                round(dot,4)

                local function set(valueNew)
                    value = valueNew == true

                    b.BackgroundColor3 = value
                        and theme.Accent or theme.Element

                    dot.Position = value
                        and UDim2.new(1,-17,0,3)
                        or UDim2.fromOffset(3,3)

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value)
                    end
                end

                b.Activated:Connect(function()
                    set(not value)
                end)

                if id then
                    Window.Controls[id] = {Set = set}
                end

                set(value)

                return {
                    SetValue = set,
                    GetValue = function() return value end
                }
            end

            -- SLIDER

            function Section:CreateSlider(config)
                config = config or {}

                local min = config.Range and config.Range[1] or 0
                local max = config.Range and config.Range[2] or 100
                local step = config.Increment or 1

                assert(max > min,"Invalid slider range")
                assert(step > 0,"Slider increment must be positive")

                local id = config.ConfigKey
                local value = math.clamp(config.CurrentValue or min,min,max)

                local row = makeRow(48,config.Name)

                local title = makeLabel(
                    row,
                    config.Name or "Slider",
                    UDim2.new(1,-65,0,20),
                    theme.Text
                )

                title:SetAttribute("UIText",true)

                local display = makeLabel(
                    row,
                    tostring(value),
                    UDim2.fromOffset(65,20),
                    theme.Accent
                )

                display.Position = UDim2.new(1,-65,0,0)
                display.TextXAlignment = Enum.TextXAlignment.Right

                local bar = new("Frame",{
                    Position = UDim2.fromOffset(0,29),
                    Size = UDim2.new(1,0,0,7),
                    BackgroundColor3 = theme.Element,
                    BorderSizePixel = 0
                },row)

                round(bar,5)

                local fill = new("Frame",{
                    Size = UDim2.new(0,0,1,0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0
                },bar)

                round(fill,5)

                local function set(newValue)
                    value = math.clamp(
                        min + math.floor((newValue-min)/step+0.5)*step,
                        min,max
                    )

                    fill.Size = UDim2.new(
                        (value-min)/(max-min),0,1,0
                    )

                    display.Text = tostring(value)

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value)
                    end
                end

                local active = false

                local function update(input)
                    local percent = math.clamp(
                        (input.Position.X-bar.AbsolutePosition.X)
                        /bar.AbsoluteSize.X,0,1
                    )

                    set(min+(max-min)*percent)
                end

                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        active = true
                        update(input)
                    end
                end)

                UIS.InputChanged:Connect(function(input)
                    if active and (
                        input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch
                    ) then
                        update(input)
                    end
                end)

                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        active = false
                    end
                end)

                if id then
                    Window.Controls[id] = {Set = set}
                end

                set(value)

                return {
                    SetValue = set,
                    GetValue = function() return value end
                }
            end

            -- DROPDOWN

            function Section:CreateDropdown(config)
                config = config or {}

                local choices = config.Options or {}
                local selected = config.CurrentOption or choices[1]
                local id = config.ConfigKey

                local row = makeRow(32,config.Name)

                local title = makeLabel(
                    row,
                    config.Name or "Dropdown",
                    UDim2.new(0.4,0,1,0),
                    theme.Text
                )

                title:SetAttribute("UIText",true)

                local b = makeButton(
                    row,
                    tostring(selected or "Select").."  ▾",
                    UDim2.new(0.42,0,0,0),
                    UDim2.new(0.58,0,1,0),
                    theme
                )

                b:SetAttribute("UIElement",true)

                local menu
                local opened = false

                local function set(option)
                    if not table.find(choices,option) then
                        return
                    end

                    selected = option
                    b.Text = tostring(option).."  ▾"

                    if id then
                        Window.Config[id] = option
                    end

                    if config.Callback then
                        task.spawn(config.Callback,option)
                    end

                    if menu then
                        menu:Destroy()
                        menu = nil
                    end

                    opened = false
                end

                b.Activated:Connect(function()
                    opened = not opened

                    if not opened then
                        if menu then menu:Destroy() menu = nil end
                        return
                    end

                    menu = new("ScrollingFrame",{
                        Position = UDim2.new(0,0,1,3),
                        Size = UDim2.new(1,0,0,math.min(#choices*29,145)),
                        BackgroundColor3 = theme.Section,
                        BorderSizePixel = 0,
                        ScrollBarThickness = 3,
                        CanvasSize = UDim2.new(0,0,0,#choices*29),
                        ZIndex = 10
                    },row)

                    round(menu,5)
                    outline(menu,theme.Border)

                    new("UIListLayout",{
                        Padding = UDim.new(0,2)
                    },menu)

                    for _,option in ipairs(choices) do
                        local item = new("TextButton",{
                            Size = UDim2.new(1,-6,0,27),
                            BackgroundColor3 = theme.Element,
                            Text = tostring(option),
                            TextColor3 = theme.Text,
                            Font = Enum.Font.Gotham,
                            TextSize = 11,
                            BorderSizePixel = 0,
                            ZIndex = 11
                        },menu)

                        item.Activated:Connect(function()
                            set(option)
                        end)
                    end
                end)

                if id then
                    Window.Controls[id] = {Set = set}
                end

                return {
                    SetValue = set,
                    GetValue = function() return selected end,
                    Refresh = function(_,newOptions)
                        choices = newOptions

                        if not table.find(choices,selected) then
                            selected = choices[1]
                            b.Text = tostring(selected or "Select").."  ▾"

                            if id then
                                Window.Config[id] = selected
                            end
                        end
                    end
                }
            end

            -- TEXTBOX

            function Section:CreateTextbox(config)
                config = config or {}

                local id = config.ConfigKey
                local value = config.CurrentValue or ""

                local row = makeRow(32,config.Name)

                local title = makeLabel(
                    row,
                    config.Name or "Textbox",
                    UDim2.new(0.4,0,1,0),
                    theme.Text
                )

                title:SetAttribute("UIText",true)

                local box = new("TextBox",{
                    Position = UDim2.new(0.42,0,0,0),
                    Size = UDim2.new(0.58,0,1,0),
                    BackgroundColor3 = theme.Element,
                    Text = value,
                    PlaceholderText = config.PlaceholderText or "Enter text...",
                    PlaceholderColor3 = theme.Muted,
                    TextColor3 = theme.Text,
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    ClearTextOnFocus = false,
                    BorderSizePixel = 0
                },row)

                round(box,5)

                local function set(newValue)
                    value = tostring(newValue or "")
                    box.Text = value

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value,false)
                    end
                end

                box.FocusLost:Connect(function(enterPressed)
                    value = box.Text

                    if id then
                        Window.Config[id] = value
                    end

                    if config.Callback then
                        task.spawn(config.Callback,value,enterPressed)
                    end
                end)

                if id then
                    Window.Controls[id] = {Set = set}
                end

                return box
            end

            -- KEYBIND

            function Section:CreateKeybind(config)
                config = config or {}

                local key = config.CurrentKey or Enum.KeyCode.K
                local id = config.ConfigKey
                local listening = false

                local row = makeRow(32,config.Name)

                local title = makeLabel(
                    row,
                    config.Name or "Keybind",
                    UDim2.new(0.6,0,1,0),
                    theme.Text
                )

                title:SetAttribute("UIText",true)

                local b = makeButton(
                    row,key.Name,
                    UDim2.new(1,-100,0,0),
                    UDim2.fromOffset(100,32),
                    theme
                )

                b:SetAttribute("UIElement",true)

                local function set(newKey)
                    if typeof(newKey) ~= "EnumItem"
                        or newKey.EnumType ~= Enum.KeyCode then
                        return
                    end

                    key = newKey
                    b.Text = key.Name

                    if id then
                        Window.Config[id] = key.Name
                    end
                end

                b.Activated:Connect(function()
                    listening = true
                    b.Text = "Press key..."
                end)

                local connection = UIS.InputBegan:Connect(function(input,processed)
                    if listening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            set(input.KeyCode)
                            listening = false
                        end
                        return
                    end

                    if processed or UIS:GetFocusedTextBox() then
                        return
                    end

                    if input.UserInputType == Enum.UserInputType.Keyboard
                        and input.KeyCode == key then

                        if config.Callback then
                            task.spawn(config.Callback,key)
                        end
                    end
                end)

                if id then
                    Window.Controls[id] = {
                        Set = function(value)
                            if typeof(value) == "string" then
                                local success,result = pcall(function()
                                    return Enum.KeyCode[value]
                                end)

                                if success and result then
                                    set(result)
                                end
                            else
                                set(value)
                            end
                        end
                    }
                end

                return {
                    SetValue = set,
                    GetValue = function() return key end,
                    Disconnect = function()
                        connection:Disconnect()
                    end
                }
            end

            return Section
        end

        tabButton.Activated:Connect(function()
            Window.ActiveTab = Tab

            for _,existing in ipairs(Window.Tabs) do
                existing.Frame.Visible = false
                existing.Button.BackgroundColor3 = theme.Element
                existing.Button.TextColor3 = theme.Muted
            end

            frame.Visible = true
            frame.Position = UDim2.fromOffset(8,0)

            animate(frame,{
                Position = UDim2.fromOffset(0,0)
            },0.18)

            tabButton.BackgroundColor3 = theme.Accent
            tabButton.TextColor3 = theme.Text
        end)

        table.insert(Window.Tabs,Tab)

        if #Window.Tabs == 1 then
            tabButton:Activate()
        end

        return Tab
    end

    --==================================================
    -- CLEANUP
    --==================================================

    gui.Destroying:Connect(function()
        Window.Destroyed = true
        keyConnection:Disconnect()

        for index,existing in ipairs(UI.Windows) do
            if existing == Window then
                table.remove(UI.Windows,index)
                break
            end
        end
    end)

    return Window
end

return UI
