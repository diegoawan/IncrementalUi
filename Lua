local function noteFreq(p, steps)
    local scale = p.sc or SC.minor
    local n = #scale
    local semi = scale[(steps % n) + 1] + math.floor(steps / n) * 12
    return (p.f or 1) * 2 ^ (semi / 12)
end

local A = {}
local function playEvents(p, events)
    for _, e in ipairs(events) do
        task.delay(e.d or 0, function()
            local f = p.f or 1
            local pitch = e.n and noteFreq(p, e.n) or e.r and f * (e.r[1] + rand() * (e.r[2] - e.r[1])) or f * (e.m or 1)
            play(e.k, (e.v or 1) * (p.v or 1), pitch, e.c or p.ch, e.tp and e.tp * f, e.td, e.l)
        end)
    end
end
local function arch(name, events) A[name] = function(p) playEvents(p, events) end end
local function notes(k, steps, gap, v, ch, start)
    local t = {}
    for i, s in ipairs(steps) do t[i] = {d=(start or 0)+(i-1)*gap, k=k, v=v, n=s, c=ch} end
    return t
end
local function rep(n, gap, mk, start)
    local t = {}
    for i = 1, n do local e = mk(i); e.d = (start or 0)+(i-1)*gap; t[i] = e end
    return t
end

