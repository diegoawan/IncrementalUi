    local ring = new("Frame", { Size = UDim2.fromOffset(78, 78), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, ZIndex = 3 }, profileFrame)
    round(ring, 999); outline(ring, theme.Glow, 2, 0.2)
    task.spawn(function() while ring.Parent do ring.Rotation = 0; tw(ring, {Rotation = 360}, 3, Enum.EasingStyle.Linear); task.wait(3) end end)

    task.spawn(function()
        local success, img = pcall(function() return Players:GetUserThumbnailAsync(Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
        if success and img then avatar.Image = img end
    end)

    local nameFrame = new("Frame", { Size = UDim2.new(1, -100, 1, 0), Position = UDim2.new(0, 100, 0, 0), BackgroundTransparency = 1 }, profileFrame)
    new("UIListLayout", {Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center}, nameFrame)

    local dName = makeLabel(nameFrame, Player.DisplayName, UDim2.new(1, 0, 0, 20), theme.Text)
    dName.Font = Enum.Font.GothamBold; dName.TextSize = 16; dName.LayoutOrder = 1
    local uName = makeLabel(nameFrame, "@" .. Player.Name, UDim2.new(1, 0, 0, 18), theme.Muted)
    uName.TextSize = 13; uName.LayoutOrder = 2

    local inputFrame = new("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, LayoutOrder = 2 }, content)

    local box = new("TextBox", {
        Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = theme.Element, Text = "", PlaceholderText = "Enter License Key...",
        PlaceholderColor3 = theme.Muted, TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14,
        ClearTextOnFocus = false, BorderSizePixel = 0, ZIndex = 5,
    }, inputFrame)
    round(box, 8); local boxGlow = outline(box, theme.Border, 1, 0)

    local errorLbl = makeLabel(inputFrame, "Invalid key. Please try again.", UDim2.new(1, 0, 0, 15), Color3.fromRGB(255, 80, 80))
    errorLbl.Position = UDim2.new(0, 0, 0, 48); errorLbl.TextXAlignment = Enum.TextXAlignment.Center; errorLbl.TextSize = 12; errorLbl.TextTransparency = 1

    box.Focused:Connect(function() tw(boxGlow, {Color = theme.Accent, Transparency = 0.2}, 0.2) end)
    box.FocusLost:Connect(function() tw(boxGlow, {Color = theme.Border, Transparency = 0}, 0.2) end)

    local btnFrame = new("Frame", { Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, LayoutOrder = 3 }, content)
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }, btnFrame)

    local getKeyBtn = makeButton(btnFrame, "Get Key", UDim2.new(), UDim2.new(0.4, -5, 1, 0), theme)
    getKeyBtn.LayoutOrder = 1
    local submitBtn = makeButton(btnFrame, "Submit", UDim2.new(), UDim2.new(0.6, -5, 1, 0), theme)
    submitBtn.LayoutOrder = 2
    submitBtn.BackgroundColor3 = theme.Accent; submitBtn.TextColor3 = theme.TabTextActive
    if submitBtn:FindFirstChild("UIGradient") then submitBtn:FindFirstChild("UIGradient"):Destroy() end
    gradient(submitBtn, theme.Accent, theme.Glow, 90)

    getKeyBtn.Activated:Connect(function()
        local link = "https://example.com/get-key"
        local success = pcall(function()
            if setclipboard then setclipboard(link) else print("[KeySystem] Link copied: " .. link) end
        end)
        if success then
            local oldText = getKeyBtn.Text
            getKeyBtn.Text = "Copied!"; getKeyBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
            task.delay(2, function() getKeyBtn.Text = oldText; getKeyBtn.TextColor3 = theme.Text end)
        end
    end)

    local isChecking = false
    local function attempt()
        if isChecking then return end
        if box.Text == correctKey then
            isChecking = true
            errorLbl.TextColor3 = Color3.fromRGB(80, 255, 80); errorLbl.Text = "Authentication Successful!"; errorLbl.TextTransparency = 0
            boxGlow.Color = Color3.fromRGB(80, 255, 80); boxGlow.Transparency = 0
            burstSparkles(main, theme.Glow, 30, 6)
            task.wait(0.8)
            tw(bg, {BackgroundTransparency = 1}, 0.4)
            tw(main, {Size = UDim2.fromOffset(0, 0)}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            task.wait(0.5); gui:Destroy()
            if options.OnSuccess then options.OnSuccess() end
        else
            errorLbl.TextColor3 = Color3.fromRGB(255, 80, 80); errorLbl.Text = "Invalid Key"; errorLbl.TextTransparency = 0
            boxGlow.Color = Color3.fromRGB(255, 80, 80); boxGlow.Transparency = 0
            local startPos = main.Position
            task.spawn(function()
                for _ = 1, 6 do
                    main.Position = startPos + UDim2.fromOffset((math.random()-0.5)*20, 0)
                    task.wait(0.03)
                end
                tw(main, {Position = startPos}, 0.15, Enum.EasingStyle.Back)
            end)
            task.delay(2, function() tw(errorLbl, {TextTransparency = 1}, 0.5); tw(boxGlow, {Color = theme.Border, Transparency = 0}, 0.5) end)
        end
    end

    submitBtn.Activated:Connect(attempt)
    box.FocusLost:Connect(function(enter) if enter then attempt() end end)
end

