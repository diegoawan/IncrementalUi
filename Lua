    White = {
        Background = Color3.fromRGB(245,245,248),
        Sidebar = Color3.fromRGB(235,235,240),
        Section = Color3.fromRGB(255,255,255),
        Element = Color3.fromRGB(239,239,243),
        Accent = Color3.fromRGB(90,90,100),
        Text = Color3.fromRGB(35,35,42),
        Muted = Color3.fromRGB(125,125,135),
        Border = Color3.fromRGB(215,215,222)
    },

    Dark = {
        Background = Color3.fromRGB(20,20,25),
        Sidebar = Color3.fromRGB(27,27,33),
        Section = Color3.fromRGB(32,32,39),
        Element = Color3.fromRGB(40,40,48),
        Accent = Color3.fromRGB(150,150,165),
        Text = Color3.fromRGB(245,245,250),
        Muted = Color3.fromRGB(155,155,165),
        Border = Color3.fromRGB(55,55,65)
    },

    Purple = {
        Background = Color3.fromRGB(22,20,30),
        Sidebar = Color3.fromRGB(29,26,39),
        Section = Color3.fromRGB(36,32,48),
        Element = Color3.fromRGB(46,41,60),
        Accent = Color3.fromRGB(155,115,255),
